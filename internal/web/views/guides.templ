// ref is a numbered link to the guide's source list.
templ ref(n int) {
	<a class="ref" href={ templ.SafeURL(fmt.Sprintf("#src-%d", n)) } aria-label={ fmt.Sprintf("Source %d", n) }>{ fmt.Sprint(n) }</a>
}

templ refs(ns []int) {
	for _, n := range ns {
		@ref(n)
	}
}

templ sourceList(list []Source) {
	<ol class="sources">
		for i, s := range list {
			<li id={ fmt.Sprintf("src-%d", i+1) }><a href={ templ.SafeURL(s.URL) } rel="nofollow">{ s.Title }</a></li>
		}
	</ol>
}

templ guideHero(crumb, title, lede string, sources int) {
	<section class="wrap">
		<div class="page-hero guide-hero">
			<div>
				<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/guides/">Guides</a><span>/</span><span>{ crumb }</span></nav>
				<h1>{ title }</h1>
				<p class="lede">{ lede }</p>
				<p class="guide-meta"><span class="chip">Updated Nov 2026</span><span class="chip">{ fmt.Sprintf("%d sources", sources) }</span></p>
			</div>
		</div>
	</section>
}

// guideCards are the two guides as cards: on the guides page and the home page.
templ guideCards() {
	<div class="guide-cards">
		<a class="guide-card" href="/guides/coffee-and-health">
			<span class="guide-visual guide-visual-health" aria-hidden="true">
				<span class="chip">Health</span>
				<b>400 mg</b>
				<span>a day for most healthy adults</span>
				<span class="bar"><span class="bar-fill bar-accent" style="width:66%"></span></span>
			</span>
			<span class="guide-card-body">
				<h3>Coffee and your health: what the research says</h3>
				<span class="brand-meta">The good, the not so good, how much caffeine is too much, and a calculator for your day.</span>
				<span class="guide-card-foot"><span class="chip">8 sources</span><span class="link">Read the guide</span></span>
			</span>
		</a>
		<a class="guide-card" href="/guides/coffee-history">
			<span class="guide-visual guide-visual-map" aria-hidden="true">
				<span class="chip">History</span>
				<img src="/static/dotmap.svg" alt="" width="1200" height="600" loading="lazy"/>
				for _, s := range stories {
					<i class="dotpin" style={ fmt.Sprintf("left:%.2f%%;top:%.2f%%", s.X, s.Y) }></i>
				}
			</span>
			<span class="guide-card-body">
				<h3>How coffee travelled the world</h3>
				<span class="brand-meta">A map of nine places, a timeline from Yemen to the 2019 auction record, and what famous names on a bag mean.</span>
				<span class="guide-card-foot"><span class="chip">11 sources</span><span class="link">Read the guide</span></span>
			</span>
		</a>
	</div>
}

// guidesTeaser is the home page's way into the guides.
templ guidesTeaser() {
	<section class="section">
		<div class="section-head">
			<div>
				<h2>Coffee guides</h2>
				<p>Short reads on caffeine, health and coffee's history. Every fact links to its source.</p>
			</div>
			<a class="btn btn-ghost" href="/guides/">All guides</a>
		</div>
		@guideCards()
	</section>
}

templ guidesHero() {
	<section class="wrap">
		<div class="page-hero">
			<div>
				<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Guides</span></nav>
				<h1>Coffee guides</h1>
				<p class="lede">Short reads on caffeine, health and coffee's history, plus how we judge a price drop. Every fact links to its source.</p>
			</div>
		</div>
	</section>
}

templ GuidesIndex(p Page) {
	@Layout(p, guidesHero()) {
		@guideCards()
		<section class="section">
			<div class="section-head">
				<div>
					<h2>Jump to an answer</h2>
					<p>Each one opens the part of a guide that answers it.</p>
				</div>
			</div>
			<div class="jump-grid">
				for _, a := range answers {
					<a class="jump-card" href={ templ.SafeURL(a.URL) }>
						<span class="jump-tag">{ a.Tag }</span>
						<h3>{ a.Q }</h3>
						<span class="brand-meta">{ a.A }</span>
					</a>
				}
			</div>
		</section>
		<section class="section">
			<div class="write-box">
				<div>
					<h2>How we write these guides</h2>
					<p>The same rule as our prices: don't take a claim on trust, show where it comes from.</p>
					<p class="write-chips"><span>FDA</span><span>EFSA</span><span>Mayo Clinic</span><span>The BMJ</span><span>IARC</span><span>AASM</span><span>Harvard Health</span><span>UNESCO</span><span>Wikipedia</span></p>
				</div>
				<ul>
					<li><b>Every claim links to its source.</b> Public health agencies, peer-reviewed research and named reference works, listed at the end of each guide.</li>
					<li><b>Links, not causes.</b> Most coffee research is observational. When a study shows a link, we call it a link.</li>
					<li><b>Not medical advice.</b> The health guide is general information. Talk to your doctor about your own caffeine limits.</li>
				</ul>
			</div>
		</section>
	}
}

templ HealthGuide(p Page, c Caffeine) {
	@Layout(p, guideHero("Health", "Coffee and your health: what the research says", "The good, the not so good, and how much caffeine is too much. Every claim links to its source.", len(healthSources))) {
		<div class="guide-layout">
			<article class="guide">
				<section class="answer-box" id="short-answer">
					<h2>The short answer</h2>
					<ul>
						<li>For most healthy adults, up to <strong>400 mg of caffeine a day</strong> isn't linked to harmful effects. The FDA puts that at about two to three 12 oz cups of coffee. @refs([]int{1, 2})</li>
						<li>Pregnant or breastfeeding? EFSA's level is <strong>200 mg a day</strong>. Ask your doctor too. @ref(2)</li>
						<li>In a big 2017 review, <strong>three to four cups a day</strong> went with a lower risk of several diseases. Those studies can't prove coffee is the cause. @ref(4)</li>
					</ul>
				</section>
				<section class="guide-section" id="calculator">
					<h2>How much caffeine is in your day?</h2>
					<p>Add the drinks you have on a normal day. Amounts are typical values from the Mayo Clinic; your cup can differ with the beans, the brew and the size. @ref(3)</p>
					@CaffeineCalc(c, "/guides/coffee-and-health#calculator")
				</section>
				<section class="guide-section" id="the-good">
					<h2>The good</h2>
					<p>A 2017 BMJ umbrella review looked at more than 200 meta-analyses. Coffee came out more likely to benefit health than to harm it. @ref(4)</p>
					<div class="fact-grid">
						<div class="fact-card fact-green"><h3>Linked with a longer life</h3><p>Coffee drinkers had a lower risk of dying from any cause, with the biggest drop at three to four cups a day. @ref(4)</p></div>
						<div class="fact-card fact-green"><h3>Lower risk of heart disease</h3><p>The same review linked coffee with less cardiovascular disease and fewer deaths from it. @ref(4)</p></div>
						<div class="fact-card fact-green"><h3>Kinder to the liver</h3><p>Coffee went with a lower risk of liver conditions, including liver cancer. @ref(4)</p></div>
						<div class="fact-card fact-green"><h3>Not shown to cause cancer</h3><p>In 2016 the WHO's cancer agency, IARC, found no conclusive evidence that drinking coffee causes cancer, and lists it as "not classifiable". @ref(6)</p></div>
					</div>
					<p class="note">These come from observational studies, so they show links, not causes. The BMJ authors say they can't recommend starting coffee for your health. @ref(4)</p>
				</section>
				<section class="guide-section" id="not-so-good">
					<h2>The not so good</h2>
					<p>None of this means coffee is bad for you. It means there are limits worth knowing.</p>
					<div class="fact-grid">
						<div class="fact-card fact-amber"><h3>It can cost you sleep</h3><p>In a 2013 study, 400 mg of caffeine taken six hours before bed cut sleep by more than an hour, and people didn't notice. The AASM, which published it, says caffeine should generally be avoided after 5 p.m. @ref(7)</p></div>
						<div class="fact-card fact-amber"><h3>Unfiltered coffee and cholesterol</h3><p>French press and Turkish coffee keep compounds called diterpenes, about 30 times more than filtered coffee. They can raise cholesterol. @ref(5)</p></div>
						<div class="fact-card fact-amber"><h3>Pregnancy needs a lower limit</h3><p>High intake in pregnancy is linked with low birth weight, preterm birth and pregnancy loss. EFSA's level is 200 mg a day; check with your doctor. @refs([]int{4, 2})</p></div>
						<div class="fact-card fact-amber"><h3>Bones in women</h3><p>The BMJ review found a higher fracture risk in women, though not in men. @ref(4)</p></div>
						<div class="fact-card fact-amber"><h3>Too much, too fast</h3><p>Signs include jitters, anxiety, a fast heart rate and poor sleep. Toxic effects such as seizures can come from about 1,200 mg taken quickly: less than half a teaspoon of pure caffeine. @ref(1)</p></div>
						<div class="fact-card fact-amber"><h3>Very hot drinks</h3><p>IARC classes drinks hotter than 65 °C as probably carcinogenic. Give your cup a minute. @ref(6)</p></div>
					</div>
					<p class="note">The research is about coffee itself, not the sugar, syrups and pastries that often come with it. @ref(4)</p>
				</section>
				<section class="guide-section" id="filter">
					<h2>Your filter matters</h2>
					<p>How you brew changes what ends up in the cup. Harvard Health suggests saving unfiltered coffee for rare occasions and keeping to fewer than five cups a day on average. @ref(5)</p>
					<div class="fact-grid">
						<div class="fact-card"><span class="badge badge-green">Filtered</span><h3>Pour-over and drip</h3><p>A filtered cup has about a thirtieth of the diterpenes of an unfiltered one. @ref(5)</p></div>
						<div class="fact-card"><span class="badge badge-amber">Unfiltered</span><h3>French press and Turkish</h3><p>About 30 times more diterpenes than filtered coffee. @ref(5)</p></div>
					</div>
				</section>
				<section class="guide-section" id="careful">
					<h2>Who should be careful</h2>
					<ul class="careful">
						<li><b>Pregnant, trying or breastfeeding:</b> the FDA says to ask your provider whether to limit caffeine; EFSA's level is 200 mg a day. @refs([]int{1, 2})</li>
						<li><b>Children and teens:</b> EFSA suggests 3 mg per kg of body weight a day as a safe level. @ref(2)</li>
						<li><b>People who feel caffeine strongly:</b> how sensitive people are, and how fast they clear caffeine, varies widely. If you cut back, go gradually: withdrawal isn't dangerous, but it can be unpleasant. @ref(1)</li>
						<li><b>Women at risk of fractures or with osteoporosis:</b> the BMJ authors suggest keeping coffee to a minimum. @ref(4)</li>
					</ul>
				</section>
				<section class="guide-section" id="myths">
					<h2>Myth or fact?</h2>
					<p>Open a card to check.</p>
					<div class="fact-grid">
						<details class="myth"><summary>"Decaf has no caffeine."</summary><p><b>Myth.</b> US rules require at least 97% of the caffeine to be removed, so a little is left. @ref(8)</p></details>
						<details class="myth"><summary>"A shot of espresso has more caffeine than a mug of coffee."</summary><p><b>Myth.</b> A 1 oz shot has about 63 mg; an 8 oz cup of brewed coffee about 96 mg. Espresso is stronger per sip, not per serving. @ref(3)</p></details>
						<details class="myth"><summary>"Coffee is on the list of things that cause cancer."</summary><p><b>Myth.</b> IARC's 2016 review found no conclusive evidence and lists coffee as "not classifiable". Drinks hotter than 65 °C are a separate warning. @ref(6)</p></details>
						<details class="myth"><summary>"Up to 400 mg a day is fine for most healthy adults."</summary><p><b>Fact.</b> That's the level the FDA and EFSA use. Pregnancy has a lower one: 200 mg a day. @refs([]int{1, 2})</p></details>
					</div>
				</section>
				<section class="guide-section" id="sources">
					<h2>Sources</h2>
					@sourceList(healthSources)
					<p class="note">This guide is general information, not medical advice. If you have a health condition, take medication or are pregnant, talk to your doctor about caffeine.</p>
				</section>
				<nav class="next-cards" aria-label="More to read">
					<a href="/guides/coffee-history"><span>Next guide</span><b>How coffee travelled the world</b></a>
					<a href="/en-us/?show=drops"><span>Back to prices</span><b>Today's US coffee drops</b></a>
				</nav>
			</article>
			<aside class="toc">
				<p class="stat-label">On this page</p>
				<a href="#short-answer">The short answer</a>
				<a href="#calculator">Caffeine calculator</a>
				<a href="#the-good">The good</a>
				<a href="#not-so-good">The not so good</a>
				<a href="#filter">Your filter matters</a>
				<a href="#careful">Who should be careful</a>
				<a href="#myths">Myth or fact?</a>
				<a href="#sources">Sources</a>
			</aside>
		</div>
	}
}

templ HistoryGuide(p Page, today []Card, labels Labels) {
	@Layout(p, guideHero("History", "How coffee travelled the world", "From Sufi communities in Yemen to auction records in Panama. Pick a place on the map to read what happened there.", len(historySources))) {
		<section class="map-card card" id="map">
			<div class="map">
				<img src="/static/dotmap.svg" alt="World map with the nine places of this guide" width="1200" height="600"/>
				for i, s := range stories {
					<a class="pin" href={ templ.SafeURL("#story-" + s.ID) } style={ fmt.Sprintf("left:%.2f%%;top:%.2f%%", s.X, s.Y) } title={ s.Place + ", " + s.Year }>{ fmt.Sprint(i + 1) }</a>
				}
			</div>
			<p class="map-note">World map dots from world-atlas data (ISC licence).</p>
		</section>
		<div class="stories">
			for i, s := range stories {
				<article class="story card" id={ "story-" + s.ID }>
					<p class="story-head"><span class="pin pin-static">{ fmt.Sprint(i + 1) }</span><span class="chip">{ s.Place }</span></p>
					<p class="story-year">{ s.Year }</p>
					<h3>{ s.Title }</h3>
					<p>{ s.Text } @refs(s.Refs)</p>
				</article>
			}
		</div>
		<section class="section" id="timeline">
			<div class="section-head">
				<div>
					<h2>The timeline</h2>
					<p>19 moments, oldest first.</p>
				</div>
			</div>
			for _, e := range eras {
				<h3 class="era">{ e.Name }</h3>
				<ol class="timeline">
					for _, m := range e.Moments {
						<li><span class="tl-year"><b>{ m.Year }</b><span>{ m.Place }</span></span><p>{ m.Text } @refs(m.Refs)</p></li>
					}
				</ol>
			}
		</section>
		<section class="section" id="names">
			<div class="section-head">
				<div>
					<h2>Famous names on a bag</h2>
					<p>Some are places, some are plants and some are ways of making coffee. Here's what each one tells you.</p>
				</div>
			</div>
			<div class="names">
				for _, n := range bagNames {
					<div class="name-item">
						<h3>{ n.Name } <span class="chip">{ n.Kind }</span></h3>
						<p>{ n.Text } @refs(n.Refs)</p>
						if n.LinkURL != "" && (n.LinkURL != "#today" || len(today) > 0) {
							<a class="link" href={ templ.SafeURL(n.LinkURL) }>{ n.LinkLabel }</a>
						}
					</div>
				}
			</div>
		</section>
		if len(today) > 0 {
			<section class="section" id="today">
				<div class="section-head">
					<div>
						<h2>From the map to today's list</h2>
						<p>The variety behind those auction records, on today's US list.</p>
					</div>
				</div>
				<section class="deal-list" aria-label="Today's Gesha coffees">
					for _, c := range today {
						@productRow(c, labels)
					}
				</section>
			</section>
		}
		<section class="section" id="sources">
			<h2>Sources</h2>
			@sourceList(historySources)
			<p class="note">Early coffee history mixes records with legend. Where a story is a legend, we say so; dates follow the sources above.</p>
		</section>
		<nav class="next-cards" aria-label="More to read">
			<a href="/guides/coffee-and-health"><span>Next guide</span><b>Coffee and your health: what the research says</b></a>
			<a href="/guides/"><span>More to read</span><b>All coffee guides</b></a>
		</nav>
	}
}
