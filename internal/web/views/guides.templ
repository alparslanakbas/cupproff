// Story is one place on the history map: "story.<id>.title" and ".text" in
// the catalog, Place a "place.<id>", Year a year or "late1400s". X and Y
// place its pin, in percent of the map's width and height.
type Story struct {
	ID, Place, Year string
	Refs            []int
	X, Y            float64
}

