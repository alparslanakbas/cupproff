}

// Answer is one card of "Jump to an answer" on the guides page:
// "answer.<id>.q" and ".a", Tag a catalog id.
type Answer struct {
	ID, Tag, URL string
}

var answers = []Answer{
	{"too_much", "guides.tag.health", "/guides/coffee-and-health#short-answer"},
	{"calculator", "guides.tag.health", "/guides/coffee-and-health#calculator"},
	{"myths", "guides.tag.health", "/guides/coffee-and-health#myths"},
	{"cholesterol", "guides.tag.health", "/guides/coffee-and-health#filter"},
	{"after5", "guides.tag.health", "/guides/coffee-and-health#not-so-good"},
	{"first", "guides.tag.history", "/guides/coffee-history#map"},
	{"timeline", "guides.tag.history", "/guides/coffee-history#timeline"},
	{"names", "guides.tag.history", "/guides/coffee-history#names"},
	{"drop", "footer.how_it_works", "/#how"},
}

// answerURL is where an answer leads in the page's language. "/#how" is the
// English home page's section; another language has the page instead.
func answerURL(ctx context.Context, a Answer) string {
	if a.URL == "/#how" && lp(ctx, "/how-it-works") != "/how-it-works" {
		return lp(ctx, "/how-it-works")
	}
	return lp(ctx, a.URL)
}

// yearText is a year as the timeline shows it: "late1400s" is words.
func yearText(ctx context.Context, y string) string {
	if strings.HasPrefix(y, "late") {
		return tr(ctx, "year."+y)
	}
	return y
}

// ref is a numbered link to the guide's source list.
templ ref(n int) {
	<a class="ref" href={ templ.SafeURL(fmt.Sprintf("#src-%d", n)) } aria-label={ tr(ctx, "guides.source_aria", "n", fmt.Sprint(n)) }>{ fmt.Sprint(n) }</a>
}

templ refs(ns []int) {
	for _, n := range ns {
		@ref(n)
	}
}

templ sourceList(list []Source) {
	<ol class="sources">
		for i, s := range list {
			<li id={ fmt.Sprintf("src-%d", i+1) }><a href={ templ.SafeURL(s.URL) } rel="nofollow">{ s.Title }</a></li>
		}
	</ol>
}

templ guideHero(p Page, crumb, title, lede string, sources int) {
	<section class="wrap">
		<div class="page-hero guide-hero">
			<div>
				<nav class="crumbs" aria-label={ tr(ctx, "nav.breadcrumb") }><a href={ templ.SafeURL(homeURL(p)) }>{ tr(ctx, "nav.home") }</a><span>/</span><a href={ templ.SafeURL(lp(ctx, "/guides/")) }>{ tr(ctx, "nav.guides") }</a><span>/</span><span>{ crumb }</span></nav>
				<h1>{ title }</h1>
				<p class="lede">{ lede }</p>
				<p class="guide-meta"><span class="chip">{ tr(ctx, "guides.updated") }</span><span class="chip">{ trn(ctx, "guides.sources", int64(sources)) }</span></p>
			</div>
		</div>
	</section>
}

// guideCards are the two guides as cards: on the guides page and the home page.
templ guideCards() {
	<div class="guide-cards">
		<a class="guide-card" href={ templ.SafeURL(lp(ctx, "/guides/coffee-and-health")) }>
			<span class="guide-visual guide-visual-health" aria-hidden="true">
				<span class="chip">{ tr(ctx, "guides.health.chip") }</span>
				<b>400 mg</b>
				<span>{ tr(ctx, "guides.health.visual") }</span>
				<span class="bar"><span class="bar-fill bar-accent" style="width: 66%"></span></span>
			</span>
			<span class="guide-card-body">
				<h3>{ tr(ctx, "guides.health.title") }</h3>
				<span class="brand-meta">{ tr(ctx, "guides.health.card") }</span>
				<span class="guide-card-foot"><span class="chip">{ trn(ctx, "guides.sources", int64(len(healthSources))) }</span><span class="link">{ tr(ctx, "guides.read") }</span></span>
			</span>
		</a>
		<a class="guide-card" href={ templ.SafeURL(lp(ctx, "/guides/coffee-history")) }>
			<span class="guide-visual guide-visual-map" aria-hidden="true">
				<span class="chip">{ tr(ctx, "guides.history.chip") }</span>
				<img src="/static/dotmap.svg" alt="" width="1200" height="600" loading="lazy"/>
				for _, s := range stories {
					<i class="dotpin" style={ fmt.Sprintf("left:%.2f%%;top:%.2f%%", s.X, s.Y) }></i>
				}
			</span>
			<span class="guide-card-body">
				<h3>{ tr(ctx, "guides.history.title") }</h3>
				<span class="brand-meta">{ tr(ctx, "guides.history.card") }</span>
				<span class="guide-card-foot"><span class="chip">{ trn(ctx, "guides.sources", int64(len(historySources))) }</span><span class="link">{ tr(ctx, "guides.read") }</span></span>
			</span>
		</a>
	</div>
}

// guidesTeaser is the home page's way into the guides.
templ guidesTeaser() {
	<section class="section">
		<div class="section-head">
			<div>
				<h2>{ tr(ctx, "guides.title") }</h2>
				<p>{ tr(ctx, "guides.teaser") }</p>
			</div>
			<a class="btn btn-ghost" href={ templ.SafeURL(lp(ctx, "/guides/")) }>{ tr(ctx, "guides.all") }</a>
		</div>
		@guideCards()
	</section>
}

templ guidesHero(p Page) {
	<section class="wrap">
		<div class="page-hero">
			<div>
				<nav class="crumbs" aria-label={ tr(ctx, "nav.breadcrumb") }><a href={ templ.SafeURL(homeURL(p)) }>{ tr(ctx, "nav.home") }</a><span>/</span><span>{ tr(ctx, "nav.guides") }</span></nav>
				<h1>{ tr(ctx, "guides.title") }</h1>
				<p class="lede">{ tr(ctx, "guides.lede") }</p>
			</div>
		</div>
	</section>
}

templ GuidesIndex(p Page) {
	@Layout(p, guidesHero(p)) {
		@guideCards()
		<section class="section">
			<div class="section-head">
				<div>
					<h2>{ tr(ctx, "guides.jump") }</h2>
					<p>{ tr(ctx, "guides.jump_lede") }</p>
				</div>
			</div>
			<div class="jump-grid">
				for _, a := range answers {
					<a class="jump-card" href={ templ.SafeURL(answerURL(ctx, a)) }>
						<span class="jump-tag">{ tr(ctx, a.Tag) }</span>
						<h3>{ tr(ctx, "answer."+a.ID+".q") }</h3>
						<span class="brand-meta">{ tr(ctx, "answer."+a.ID+".a") }</span>
					</a>
				}
			</div>
		</section>
		<section class="section">
			<div class="write-box">
				<div>
					<h2>{ tr(ctx, "guides.write.h") }</h2>
					<p>{ tr(ctx, "guides.write.p") }</p>
					<p class="write-chips"><span>FDA</span><span>EFSA</span><span>Mayo Clinic</span><span>The BMJ</span><span>IARC</span><span>AASM</span><span>Harvard Health</span><span>UNESCO</span><span>Wikipedia</span></p>
				</div>
				<ul>
					for _, s := range []string{"li1", "li2", "li3"} {
						<li>
							@trh(ctx, "guides.write."+s)
						</li>
					}
				</ul>
			</div>
		</section>
	}
}

// The health guide's cards, in order; each is "<part>.<id>.h" and ".p".
var goodCards = []struct {
	id   string
	refs []int
}{{"life", []int{4}}, {"heart", []int{4}}, {"liver", []int{4}}, {"cancer", []int{6}}}

var badCards = []struct {
	id   string
	refs []int
}{{"sleep", []int{7}}, {"cholesterol", []int{5}}, {"pregnancy", []int{4, 2}}, {"bones", []int{4}}, {"toomuch", []int{1}}, {"hot", []int{6}}}

var carefulItems = []struct {
	id   string
	refs []int
}{{"pregnant", []int{1, 2}}, {"children", []int{2}}, {"sensitive", []int{1}}, {"fractures", []int{4}}}

var myths = []struct {
	id   string
	refs []int
}{{"decaf", []int{8}}, {"espresso", []int{3}}, {"cancer", []int{6}}, {"limit", []int{1, 2}}}

// healthToc is the health guide's "On this page": a section and its name.
var healthToc = []struct{ id, name string }{
	{"short-answer", "health.short.h"}, {"calculator", "calc.caffeine.title"}, {"the-good", "health.good.h"},
	{"not-so-good", "health.bad.h"}, {"filter", "health.filter.h"}, {"careful", "health.careful.h"},
	{"myths", "health.myths.h"}, {"sources", "guides.sources_h"},
}

templ HealthGuide(p Page, c Caffeine, drops NavLink) {
	@Layout(p, guideHero(p, tr(ctx, "guides.health.chip"), tr(ctx, "guides.health.title"), tr(ctx, "health.lede"), len(healthSources))) {
		<div class="guide-layout">
			<article class="guide">
				<section class="answer-box" id="short-answer">
					<h2>{ tr(ctx, "health.short.h") }</h2>
					<ul>
						<li>
							@trh(ctx, "health.short.li1")
							@templ.Raw(" ")
							@refs([]int{1, 2})
						</li>
						<li>
							@trh(ctx, "health.short.li2")
							@templ.Raw(" ")
							@ref(2)
						</li>
						<li>
							@trh(ctx, "health.short.li3")
							@templ.Raw(" ")
							@ref(4)
						</li>
					</ul>
				</section>
				<section class="guide-section" id="calculator">
					<h2>{ tr(ctx, "health.calc.h") }</h2>
					<p>{ tr(ctx, "calc.caffeine.intro") } @ref(3)</p>
					@CaffeineCalc(c, lp(ctx, "/guides/coffee-and-health")+"#calculator")
				</section>
				<section class="guide-section" id="the-good">
					<h2>{ tr(ctx, "health.good.h") }</h2>
					<p>{ tr(ctx, "health.good.p") } @ref(4)</p>
					<div class="fact-grid">
						for _, f := range goodCards {
							<div class="fact-card fact-green"><h3>{ tr(ctx, "health.good."+f.id+".h") }</h3><p>{ tr(ctx, "health.good."+f.id+".p") } @refs(f.refs)</p></div>
						}
					</div>
					<p class="note">{ tr(ctx, "health.good.note") } @ref(4)</p>
				</section>
				<section class="guide-section" id="not-so-good">
					<h2>{ tr(ctx, "health.bad.h") }</h2>
					<p>{ tr(ctx, "health.bad.p") }</p>
					<div class="fact-grid">
						for _, f := range badCards {
							<div class="fact-card fact-amber"><h3>{ tr(ctx, "health.bad."+f.id+".h") }</h3><p>{ tr(ctx, "health.bad."+f.id+".p") } @refs(f.refs)</p></div>
						}
					</div>
					<p class="note">{ tr(ctx, "health.bad.note") } @ref(4)</p>
				</section>
				<section class="guide-section" id="filter">
					<h2>{ tr(ctx, "health.filter.h") }</h2>
					<p>{ tr(ctx, "health.filter.p") } @ref(5)</p>
					<div class="fact-grid">
						<div class="fact-card"><span class="badge badge-green">{ tr(ctx, "health.filter.filtered") }</span><h3>{ tr(ctx, "health.filter.filtered.h") }</h3><p>{ tr(ctx, "health.filter.filtered.p") } @ref(5)</p></div>
						<div class="fact-card"><span class="badge badge-amber">{ tr(ctx, "health.filter.unfiltered") }</span><h3>{ tr(ctx, "health.filter.unfiltered.h") }</h3><p>{ tr(ctx, "health.filter.unfiltered.p") } @ref(5)</p></div>
					</div>
				</section>
				<section class="guide-section" id="careful">
					<h2>{ tr(ctx, "health.careful.h") }</h2>
					<ul class="careful">
						for _, it := range carefulItems {
							<li>
								@trh(ctx, "health.careful."+it.id)
								@templ.Raw(" ")
								@refs(it.refs)
							</li>
						}
					</ul>
				</section>
				<section class="guide-section" id="myths">
					<h2>{ tr(ctx, "health.myths.h") }</h2>
					<p>{ tr(ctx, "health.myths.p") }</p>
					<div class="fact-grid">
						for _, m := range myths {
							<details class="myth">
								<summary>{ tr(ctx, "health.myth."+m.id+".q") }</summary>
								<p>
									@trh(ctx, "health.myth."+m.id+".a")
									@templ.Raw(" ")
									@refs(m.refs)
								</p>
							</details>
						}
					</div>
				</section>
				<section class="guide-section" id="sources">
					<h2>{ tr(ctx, "guides.sources_h") }</h2>
					@sourceList(healthSources)
					<p class="note">{ tr(ctx, "health.note") }</p>
				</section>
				<nav class="next-cards" aria-label={ tr(ctx, "guides.more") }>
					<a href={ templ.SafeURL(lp(ctx, "/guides/coffee-history")) }><span>{ tr(ctx, "guides.next") }</span><b>{ tr(ctx, "guides.history.title") }</b></a>
					<a href={ templ.SafeURL(drops.URL) }><span>{ tr(ctx, "guides.back_prices") }</span><b>{ drops.Name }</b></a>
				</nav>
			</article>
			<aside class="toc">
				<p class="stat-label">{ tr(ctx, "guides.on_page") }</p>
				for _, t := range healthToc {
					<a href={ templ.SafeURL("#" + t.id) }>{ tr(ctx, t.name) }</a>
				}
			</aside>
		</div>
	}
}

templ HistoryGuide(p Page, today []Card, labels Labels, market string) {
	@Layout(p, guideHero(p, tr(ctx, "guides.history.chip"), tr(ctx, "guides.history.title"), tr(ctx, "history.lede"), len(historySources))) {
		<section class="map-card card" id="map">
			<div class="map">
				<img src="/static/dotmap.svg" alt={ tr(ctx, "history.map_alt") } width="1200" height="600"/>
				for i, s := range stories {
					<a class="pin" href={ templ.SafeURL("#story-" + s.ID) } style={ fmt.Sprintf("left:%.2f%%;top:%.2f%%", s.X, s.Y) } title={ tr(ctx, "place."+s.Place) + ", " + yearText(ctx, s.Year) }>{ fmt.Sprint(i + 1) }</a>
				}
			</div>
			<p class="map-note">{ tr(ctx, "history.map_note") }</p>
		</section>
		<div class="stories">
			for i, s := range stories {
				<article class="story card" id={ "story-" + s.ID }>
					<p class="story-head"><span class="pin pin-static">{ fmt.Sprint(i + 1) }</span><span class="chip">{ tr(ctx, "place."+s.Place) }</span></p>
					<p class="story-year">{ yearText(ctx, s.Year) }</p>
					<h3>{ tr(ctx, "story."+s.ID+".title") }</h3>
					<p>{ tr(ctx, "story."+s.ID+".text") } @refs(s.Refs)</p>
				</article>
			}
		</div>
		<section class="section" id="timeline">
			<div class="section-head">
				<div>
					<h2>{ tr(ctx, "history.timeline.h") }</h2>
					<p>{ tr(ctx, "history.timeline.p") }</p>
				</div>
			</div>
			for _, e := range eras {
				<h3 class="era">{ tr(ctx, "era."+e.ID) }</h3>
				<ol class="timeline">
					for _, m := range e.Moments {
						<li><span class="tl-year"><b>{ yearText(ctx, m.Year) }</b><span>{ tr(ctx, "place."+m.Place) }</span></span><p>{ tr(ctx, "moment."+m.Year+".text") } @refs(m.Refs)</p></li>
					}
				</ol>
			}
		</section>
		<section class="section" id="names">
			<div class="section-head">
				<div>
					<h2>{ tr(ctx, "history.names.h") }</h2>
					<p>{ tr(ctx, "history.names.p") }</p>
				</div>
			</div>
			<div class="names">
				for _, n := range bagNames {
					<div class="name-item">
						<h3>{ tr(ctx, "bag."+n.ID+".name") } <span class="chip">{ tr(ctx, "bagkind."+n.Kind) }</span></h3>
						<p>{ tr(ctx, "bag."+n.ID+".text") } @refs(n.Refs)</p>
						if n.LinkURL != "" && (n.LinkURL != "#today" || len(today) > 0) {
							<a class="link" href={ templ.SafeURL(lp(ctx, n.LinkURL)) }>{ tr(ctx, "bag."+n.ID+".link") }</a>
						}
					</div>
				}
			</div>
		</section>
		if len(today) > 0 {
			<section class="section" id="today">
				<div class="section-head">
					<div>
						<h2>{ tr(ctx, "history.today.h") }</h2>
						<p>{ tr(ctx, "history.today.p", "market", market) }</p>
					</div>
				</div>
				<section class="deal-list" aria-label={ tr(ctx, "history.today.aria") }>
					for _, c := range today {
						@productRow(c, labels)
					}
				</section>
			</section>
		}
		<section class="section" id="sources">
			<h2>{ tr(ctx, "guides.sources_h") }</h2>
			@sourceList(historySources)
			<p class="note">{ tr(ctx, "history.note") }</p>
		</section>
		<nav class="next-cards" aria-label={ tr(ctx, "guides.more") }>
			<a href={ templ.SafeURL(lp(ctx, "/guides/coffee-and-health")) }><span>{ tr(ctx, "guides.next") }</span><b>{ tr(ctx, "guides.health.title") }</b></a>
			<a href={ templ.SafeURL(lp(ctx, "/guides/")) }><span>{ tr(ctx, "guides.more") }</span><b>{ tr(ctx, "guides.all_guides") }</b></a>
		</nav>
	}
}
