package views

import (
	"context"
	"fmt"
	"strings"
)

// The guides' text, in every language, is in the catalog; this file keeps
// their shape: which sources a claim cites, where a pin sits on the map.
// Every fact was checked against the source it cites on 4 Nov 2026. The
// design's drafts said a few things the sources don't (Java's seedlings sent
// "from Yemen": they went from Malabar, India; Bezzera's patent in 1901:
// granted 1902; Hawaii's first coffee in 1825: not in either source); those
// are corrected or gone. Keep it that way, in every language: a new claim
// gets a source, or it doesn't go in.

// Drink is one row of the caffeine calculator.
type Drink struct {
	Key     string
	Name    string
	Serving string
	Mg      int
	Count   int
}

// Caffeine is the calculator's state, worked out by the server.
type Caffeine struct {
	Drinks     []Drink
	Total      int
	BarPercent int    // of the 600 mg scale
	Level      string // "green", "accent" or "amber"
	Message    string
}

// CaffeineCalc is the caffeine calculator: in the health guide and on its
// own page among the calculators. A GET form, worked out by the server.
templ CaffeineCalc(c Caffeine, action string) {
	<form class="calc" method="get" action={ templ.SafeURL(action) }>
		<div class="card calc-drinks">
			for _, d := range c.Drinks {
				<label class="drink">
					<span class="drink-name"><b>{ d.Name }</b><span>{ tr(ctx, "calc.drink_line", "serving", d.Serving, "mg", fmt.Sprint(d.Mg)) }</span></span>
					<input type="number" name={ d.Key } min="0" max="10" step="1" value={ fmt.Sprint(d.Count) } inputmode="numeric"/>
				</label>
			}
			<button class="btn btn-primary" type="submit">{ tr(ctx, "calc.add_up") }</button>
		</div>
		<div class={ "card", "calc-total", "calc-" + c.Level } aria-live="polite">
			<p class="stat-label">{ tr(ctx, "calc.your_day") }</p>
			<p class="calc-mg"><b>{ fmt.Sprint(c.Total) }</b> mg</p>
			<span class="bar" aria-hidden="true"><span class={ "bar-fill", "bar-" + c.Level } style={ fmt.Sprintf("width:%d%%", c.BarPercent) }></span></span>
			<span class="bar-scale" aria-hidden="true"><span>0</span><span>200 mg</span><span>400 mg</span><span>600</span></span>
			<p class="calc-msg">{ c.Message }</p>
		</div>
	</form>
}

// Source is one entry of a guide's numbered source list. Its title stays as
// the source names itself, in English.
type Source struct {
	Title, URL string
}

