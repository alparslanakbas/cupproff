// BagName is one of the famous names on a coffee bag: "bag.<id>.name" and
// ".text", and ".link" when it links; Kind is a "bagkind.<id>".
type BagName struct {
	ID, Kind string
	Refs     []int
	LinkURL  string // "#today" is shown only when today's list has one
}

var bagNames = []BagName{
