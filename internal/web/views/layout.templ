package views

import "fmt"

// Page is what every page tells the layout about itself.
type Page struct {
	Title       string
	Description string
	Lang        string
	Canonical   string
	Alternates  []Alternate
	JSONLD      string // already marshalled with HTML escaping
	NoIndex     bool
	Nav         []NavLink // the market's sections; empty outside a market
	Regions     []NavLink // the same page in the other markets, when it exists there
	MarketNote  string    // what a buyer must know about this market's prices
}

// NavLink is one section of a market (Coffee, Tea) in the header.
type NavLink struct {
	Name    string
	URL     string
	Current bool
}

// StylesheetURL carries a content hash (set by the web package at start-up),
// so a deploy that changes the CSS changes the URL and no visitor keeps a
// day-old cached copy.
var StylesheetURL = "/static/site.css"

// Alternate is one hreflang sibling of the page.
type Alternate struct {
	Lang string
	URL  string
}

// currentRegion is the short name of the region the page belongs to.
func currentRegion(regions []NavLink) string {
	for _, r := range regions {
		if r.Current {
			return r.Name
		}
	}
	return "Region"
}

templ Layout(p Page, hero templ.Component) {
	<!DOCTYPE html>
	<html lang={ p.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			if p.Description != "" {
				<meta name="description" content={ p.Description }/>
			}
			if p.NoIndex {
				<meta name="robots" content="noindex"/>
			} else {
				<meta name="robots" content="max-image-preview:large"/>
			}
			if p.Canonical != "" {
				<link rel="canonical" href={ templ.SafeURL(p.Canonical) }/>
			}
			for _, a := range p.Alternates {
				<link rel="alternate" hreflang={ a.Lang } href={ templ.SafeURL(a.URL) }/>
			}
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#120D0A"/>
			<link rel="preload" href="/static/inter.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/static/funnel-display-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ StylesheetURL }/>
			if p.JSONLD != "" {
				@templ.Raw(`<script type="application/ld+json">` + p.JSONLD + `</script>`)
			}
		</head>
		<body>
			<header class="site-header">
				<div class="wrap header-row">
					<a class="logo" href="/">
						@logoMark()
						<span>CoffeeProof</span>
					</a>
					if len(p.Nav) > 0 {
						<nav class="mainnav" aria-label="Sections">
							for _, n := range p.Nav {
								if n.Current {
									<a href={ templ.SafeURL(n.URL) } aria-current="page">{ n.Name }</a>
								} else {
									<a href={ templ.SafeURL(n.URL) }>{ n.Name }</a>
								}
							}
						</nav>
					}
					if len(p.Regions) > 0 {
						<details class="region">
							<summary>
								@iconGlobe()
								<span>{ currentRegion(p.Regions) }</span>
							</summary>
							<nav class="region-menu" aria-label="Region">
								for _, n := range p.Regions {
									if n.Current {
										<a href={ templ.SafeURL(n.URL) } aria-current="page">{ n.Name }</a>
									} else {
										<a href={ templ.SafeURL(n.URL) }>{ n.Name }</a>
									}
								}
							</nav>
						</details>
					}
				</div>
			</header>
			@hero
			<main class="wrap">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="wrap footer-grid">
					<div class="footer-about">
						<a class="logo" href="/">
							@logoMark()
							<span>CoffeeProof</span>
						</a>
						<p>We read coffee and tea prices every day and judge discounts by the price history we collect, not by the store's own "was" price.</p>
					</div>
					<div>
						<h2>Coffee</h2>
						<ul>
							<li><a href="/en-us/">US coffee</a></li>
							<li><a href="/en-gb/">UK coffee</a></li>
							<li><a href="/en-eu/">EU coffee</a></li>
						</ul>
					</div>
					<div>
						<h2>Tea</h2>
						<ul>
							<li><a href="/en-us/tea/">US tea</a></li>
							<li><a href="/en-gb/tea/">UK tea</a></li>
							<li><a href="/en-eu/tea/">EU tea</a></li>
						</ul>
					</div>
					<div>
						<h2>Read</h2>
						<ul>
							<li><a href="/en-us/brands/">Brands</a></li>
							<li><a href="/guides/">Coffee guides</a></li>
							<li><a href="/guides/coffee-and-health#calculator">Caffeine calculator</a></li>
						</ul>
					</div>
					<div class="footer-note">
						<h2>How prices are read</h2>
						if p.MarketNote != "" {
							<p>{ p.MarketNote }</p>
						}
						<p>Prices are the ones each store shows to your country, read daily; shipping is not included. A real drop is measured against the price a product sold for on at least 7 of the last 30 days, never against the store's own "was" price.</p>
					</div>
				</div>
				<div class="wrap footer-mark" aria-hidden="true">CoffeeProof</div>
				<div class="wrap footer-bottom">
					<span>CoffeeProof is independent. Purchases happen on the store's own site.</span>
					<span>Prices checked daily.</span>
				</div>
			</footer>
		</body>
	</html>
}

templ logoMark() {
	<span class="logo-mark" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<path d="M5 9h11v5a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5z"></path>
			<path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"></path>
			<path d="M9 3c-.6 1 .6 2 0 3M12.5 3c-.6 1 .6 2 0 3"></path>
		</svg>
	</span>
}

templ iconGlobe() {
	<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
		<circle cx="12" cy="12" r="9"></circle>
		<path d="M3 12h18M12 3c2.5 2.8 2.5 15.2 0 18M12 3c-2.5 2.8-2.5 15.2 0 18"></path>
	</svg>
}

// Amount writes "1 tea" or "2,956 teas".
func Amount(n int64, one, many string) string {
	if n == 1 {
		return "1 " + one
	}
	return count(n, many)
}

// count writes "2,956 teas": thousands grouped, the way the stores write prices.
func count(n int64, noun string) string {
	s := fmt.Sprint(n)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "," + s[i:]
	}
	return s + " " + noun
}
