package views

import "fmt"

// Page is what every page tells the layout about itself.
type Page struct {
	Title       string
	Description string
	Lang        string
	Canonical   string
	Alternates  []Alternate
	JSONLD      string // already marshalled with HTML escaping
	NoIndex     bool
	Nav         []NavLink // the market's sections; empty outside a market
	Regions     []NavLink // the same page in the other markets, when it exists there
	MarketNote  string    // what a buyer must know about this market's prices
}

// NavLink is one section of a market (Coffee, Tea) in the header.
type NavLink struct {
	Name    string
	URL     string
	Current bool
}

// StylesheetURL carries a content hash (set by the web package at start-up),
// so a deploy that changes the CSS changes the URL and no visitor keeps a
// day-old cached copy.
var StylesheetURL = "/static/site.css"

// Alternate is one hreflang sibling of the page.
type Alternate struct {
	Lang string
	URL  string
}

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang={ p.Lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			if p.Description != "" {
				<meta name="description" content={ p.Description }/>
			}
			if p.NoIndex {
				<meta name="robots" content="noindex"/>
			} else {
				<meta name="robots" content="max-image-preview:large"/>
			}
			if p.Canonical != "" {
				<link rel="canonical" href={ templ.SafeURL(p.Canonical) }/>
			}
			for _, a := range p.Alternates {
				<link rel="alternate" hreflang={ a.Lang } href={ templ.SafeURL(a.URL) }/>
			}
			<meta name="color-scheme" content="light dark"/>
			<link rel="preload" href="/static/fraunces.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/static/plex-sans.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ StylesheetURL }/>
			if p.JSONLD != "" {
				@templ.Raw(`<script type="application/ld+json">` + p.JSONLD + `</script>`)
			}
		</head>
		<body>
			<header class="site-header">
				<div class="wrap header-row">
					<a class="brand" href="/">CupProof</a>
					if len(p.Nav) > 0 {
						<nav class="sections" aria-label="Sections">
							for _, n := range p.Nav {
								if n.Current {
									<a href={ templ.SafeURL(n.URL) } aria-current="page">{ n.Name }</a>
								} else {
									<a href={ templ.SafeURL(n.URL) }>{ n.Name }</a>
								}
							}
						</nav>
					}
					if len(p.Regions) > 0 {
						<nav class="regions" aria-label="Region">
							for _, n := range p.Regions {
								if n.Current {
									<a href={ templ.SafeURL(n.URL) } aria-current="page">{ n.Name }</a>
								} else {
									<a href={ templ.SafeURL(n.URL) }>{ n.Name }</a>
								}
							}
						</nav>
					}
				</div>
			</header>
			<main class="wrap">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="wrap">
					if p.MarketNote != "" {
						<p class="market-note">{ p.MarketNote }</p>
					}
					<p>Prices are the ones each store shows to your country, read daily; shipping is not included. A real drop is measured against the price a bag sold for on at least 7 of the last 30 days, never against the store's own "was" price.</p>
					<p>CupProof is independent. Every link goes to the store's own page.</p>
				</div>
			</footer>
		</body>
	</html>
}

// count writes "2,956 teas": thousands grouped, the way the stores write prices.
func count(n int64, noun string) string {
	s := fmt.Sprint(n)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "," + s[i:]
	}
	return s + " " + noun
}
