package views

import (
	"context"

	"github.com/alparslanakbas/cupproof/internal/i18n"
)

// CategoryCard is one tile of a card grid: a category, a calculator.
type CategoryCard struct {
	Label string
	URL   string
	Icon  string
	Count string
	About string
}

// CategoryGroup is a section's categories on the categories page.
type CategoryGroup struct {
	Name  string
	All   string // the group's link: "All coffee"
	URL   string
	Icon  string
	Count string
	Items []CategoryCard
}

// BrewRatio is the brew ratio calculator, worked out by the server.
type BrewRatio struct {
	Coffee, Water, Ratio string
	From                 string // "water" when the visitor gave the water
	Ratios               []Option
	Answer               string
	Cups                 string
	Problem              string
}

// CostPerCup is the cost per cup calculator, worked out by the server.
type CostPerCup struct {
	Price, Grams, Dose string
	PerCup, Cups       string
	PerKilo            string
	Problem            string
}

// Quiz is the "which coffee?" quiz: the answers so far and the result.
type Quiz struct {
	Drink, Caffeine, Brew, Taste string
	Result                       *QuizResult
}

// QuizResult is the quiz's answer: a category, why, and today's deals in it.
type QuizResult struct {
	Title   string
	Why     string
	Cat     string // the category's slug: its deals heading is "quiz.<cat>.deals"
	Market  string // the list's market, by its short name: "US", "UE"
	URL     string
	Count   int64
	Cards   []Card
	Labels  Labels
	Markets []NavLink
}

// MarketCount is one market's real drops and store sales today.
type MarketCount struct {
	Market string
	URL    string
	Drops  int64
	Sales  int64
}

// DealsBlock is a short list with a title and a link to the whole list.
type DealsBlock struct {
	Title  string
	Cards  []Card
	Labels Labels
	URL    string
	Count  int64
	Show   string
}

// Categories is a market's category directory.
templ Categories(p Page, market string, groups []CategoryGroup) {
	@Layout(p, pageHead([]NavLink{{Name: tr(ctx, "nav.home"), URL: "/"}, {Name: market}, {Name: tr(ctx, "nav.categories")}}, tr(ctx, "nav.all_categories"),
		tr(ctx, "categories.lede"))) {
		for _, g := range groups {
			<section class="cat-group">
				<div class="section-head">
					<h2>
						<span class="cat-icon">
							@icon(g.Icon)
						</span>
						{ g.Name }
					</h2>
					<a class="btn btn-ghost" href={ templ.SafeURL(g.URL) }>
						{ g.All + ", " + g.Count }
						@icon("arrow-right")
					</a>
				</div>
				@tileGrid(g.Items)
			</section>
		}
	}
}

// tileGrid is a grid of icon cards.
templ tileGrid(items []CategoryCard) {
	<div class="tile-grid">
		for _, it := range items {
			<a class="tile-card" href={ templ.SafeURL(it.URL) }>
				<span class="tile-head">
					<span class="cat-icon">
						@icon(it.Icon)
					</span>
					if it.Count != "" {
						<span class="tile-count">{ it.Count }</span>
					}
				</span>
				<span class="tile-title">{ it.Label }</span>
				<span class="tile-about">{ it.About }</span>
				<span class="tile-go">
					{ tr(ctx, "categories.open") }
					@icon("arrow-right")
				</span>
			</a>
		}
	</div>
}

// calcLinks are a calculator page's crumbs.
func calcLinks(ctx context.Context, p Page, name string) []NavLink {
	return []NavLink{{Name: tr(ctx, "nav.home"), URL: homeURL(p)}, {Name: tr(ctx, "nav.calculators"), URL: lp(ctx, "/calculators/")}, {Name: name}}
}

// Calculators is the calculators' index.
templ Calculators(p Page, cards []CategoryCard) {
	@Layout(p, pageHead([]NavLink{{Name: tr(ctx, "nav.home"), URL: homeURL(p)}, {Name: tr(ctx, "nav.calculators")}}, tr(ctx, "calcs.title"),
		tr(ctx, "calcs.lede"))) {
		@tileGrid(cards)
	}
}

// CaffeinePage is the caffeine calculator on its own page.
templ CaffeinePage(p Page, c Caffeine) {
	@Layout(p, pageHead(calcLinks(ctx, p, tr(ctx, "calc.caffeine.crumb")), tr(ctx, "calc.caffeine.title"), tr(ctx, "calc.caffeine.intro"))) {
		<section class="tool">
			@CaffeineCalc(c, lp(ctx, "/calculators/caffeine"))
			<p class="note">
				@trh(ctx, "calc.caffeine.note", "guide", lp(ctx, "/guides/coffee-and-health"))
			</p>
		</section>
	}
}

// BrewRatioPage is the brew ratio calculator.
templ BrewRatioPage(p Page, b BrewRatio) {
	@Layout(p, pageHead(calcLinks(ctx, p, tr(ctx, "calc.brew-ratio.crumb")), tr(ctx, "calc.brew-ratio.title"), tr(ctx, "calc.brew-ratio.intro"))) {
		<section class="tool tool-grid">
			<form class="card tool-form" method="get" action={ templ.SafeURL(lp(ctx, "/calculators/brew-ratio")) }>
				<label class="field">
					<span>{ tr(ctx, "brew.coffee") }</span>
					<input type="number" name="coffee" min="1" max="2000" step="0.1" value={ b.Coffee } inputmode="decimal"/>
				</label>
				<p class="field-or">{ tr(ctx, "brew.or") }</p>
				<label class="field">
					<span>{ tr(ctx, "brew.water") }</span>
					<input type="number" name="water" min="1" max="20000" step="1" value={ b.Water } inputmode="numeric"/>
				</label>
				<label class="field">
					<span>{ tr(ctx, "brew.ratio") }</span>
					<select class="filter-control" name="ratio">
						for _, o := range b.Ratios {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</label>
				<fieldset class="field">
					<legend>{ tr(ctx, "brew.work_out") }</legend>
					<label class="radio"><input type="radio" name="from" value="coffee" checked?={ b.From != "water" }/> { tr(ctx, "brew.from_coffee") }</label>
					<label class="radio"><input type="radio" name="from" value="water" checked?={ b.From == "water" }/> { tr(ctx, "brew.from_water") }</label>
				</fieldset>
				<button class="btn btn-primary" type="submit">{ tr(ctx, "calc.submit") }</button>
			</form>
			<div class="card tool-result" aria-live="polite">
				<p class="kicker">{ tr(ctx, "brew.recipe") }</p>
				if b.Problem != "" {
					<p class="tool-problem">{ b.Problem }</p>
				} else {
					<p class="tool-answer">{ b.Answer }</p>
					if b.Cups != "" {
						<p class="tool-sub">{ b.Cups }</p>
					}
				}
			</div>
		</section>
	}
}

// CostPerCupPage is the cost per cup calculator.
templ CostPerCupPage(p Page, c CostPerCup) {
	@Layout(p, pageHead(calcLinks(ctx, p, tr(ctx, "calc.cost-per-cup.crumb")), tr(ctx, "calc.cost-per-cup.title"), tr(ctx, "calc.cost-per-cup.intro"))) {
		<section class="tool tool-grid">
			<form class="card tool-form" method="get" action={ templ.SafeURL(lp(ctx, "/calculators/cost-per-cup")) }>
				<label class="field">
					<span>{ tr(ctx, "cost.price") }</span>
					<input type="number" name="price" min="0.01" max="100000" step="0.01" value={ c.Price } inputmode="decimal"/>
				</label>
				<label class="field">
					<span>{ tr(ctx, "cost.grams") }</span>
					<input type="number" name="grams" min="1" max="100000" step="1" value={ c.Grams } inputmode="numeric"/>
				</label>
				<label class="field">
					<span>{ tr(ctx, "cost.dose") }</span>
					<input type="number" name="dose" min="1" max="100" step="0.5" value={ c.Dose } inputmode="decimal"/>
				</label>
				<button class="btn btn-primary" type="submit">{ tr(ctx, "calc.submit") }</button>
			</form>
			<div class="card tool-result" aria-live="polite">
				<p class="kicker">{ tr(ctx, "cost.per_cup") }</p>
				if c.Problem != "" {
					<p class="tool-problem">{ c.Problem }</p>
				} else {
					<p class="tool-big">{ c.PerCup }</p>
					<p class="tool-sub">{ tr(ctx, "cost.cups", "cups", c.Cups, "per_kilo", c.PerKilo) }</p>
				}
			</div>
		</section>
	}
}

// quizOption is one answer of a quiz question: a radio button.
templ quizOption(name, value, label, current string) {
	<label class="choice">
		<input type="radio" name={ name } value={ value } checked?={ current == value } required/>
		<span>{ label }</span>
	</label>
}

// quizChoice is an optional answer of the third question.
templ quizChoice(name, value, current string) {
	<label class="choice"><input type="radio" name={ name } value={ value } checked?={ current == value }/><span>{ tr(ctx, "quiz."+name+"."+value) }</span></label>
}

// WhichCoffee is the quiz: the questions, and the answer when they are done.
templ WhichCoffee(p Page, q Quiz) {
	@Layout(p, pageHead([]NavLink{{Name: tr(ctx, "nav.home"), URL: homeURL(p)}, {Name: tr(ctx, "nav.which_coffee")}}, tr(ctx, "quiz.title"),
		tr(ctx, "quiz.lede"))) {
		<section class="tool tool-grid quiz">
			<form class="card tool-form" method="get" action={ templ.SafeURL(lp(ctx, "/which-coffee")) }>
				<fieldset class="question">
					<legend><b>1</b> { tr(ctx, "quiz.q_drink") }</legend>
					@quizOption("drink", "coffee", tr(ctx, "kind.coffee.nav"), q.Drink)
					@quizOption("drink", "tea", tr(ctx, "kind.tea.nav"), q.Drink)
				</fieldset>
				<fieldset class="question">
					<legend><b>2</b> { tr(ctx, "quiz.q_caffeine") }</legend>
					@quizOption("caffeine", "yes", tr(ctx, "quiz.caffeine.yes"), q.Caffeine)
					@quizOption("caffeine", "less", tr(ctx, "quiz.caffeine.less"), q.Caffeine)
				</fieldset>
				<fieldset class="question">
					<legend><b>3</b> { tr(ctx, "quiz.q_brew") }</legend>
					for _, v := range []string{"espresso", "filter", "press", "unsure"} {
						@quizChoice("brew", v, q.Brew)
					}
				</fieldset>
				<fieldset class="question">
					<legend><b>3</b> { tr(ctx, "quiz.q_taste") }</legend>
					for _, v := range []string{"strong", "fresh", "between", "earthy", "whisked", "spiced"} {
						@quizChoice("taste", v, q.Taste)
					}
				</fieldset>
				<button class="btn btn-primary" type="submit">{ tr(ctx, "quiz.submit") }</button>
			</form>
			<div class="card tool-result" aria-live="polite">
				if q.Result != nil {
					<p class="kicker">{ tr(ctx, "quiz.start_with") }</p>
					<p class="tool-answer">{ q.Result.Title }</p>
					<p class="tool-sub">{ q.Result.Why }</p>
					<a class="btn btn-primary" href={ templ.SafeURL(q.Result.URL) }>
						{ tr(ctx, "quiz.see_all", "n", i18n.Number(i18n.Lang(ctx), q.Result.Count), "market", q.Result.Market) }
						@icon("arrow-right")
					</a>
					<p class="tool-sub">
						{ tr(ctx, "quiz.other_regions") }
						for _, m := range q.Result.Markets {
							<a class="link" href={ templ.SafeURL(m.URL) }>{ m.Name }</a>
						}
					</p>
				} else if q.Drink != "" || q.Caffeine != "" {
					<p class="tool-problem">{ tr(ctx, "quiz.incomplete") }</p>
				} else {
					<p class="kicker">{ tr(ctx, "quiz.your_answer") }</p>
					<p class="tool-sub">{ tr(ctx, "quiz.pick") }</p>
				}
			</div>
		</section>
		if q.Result != nil && len(q.Result.Cards) > 0 {
			<section class="section">
				<div class="section-head">
					<div>
						<h2>{ tr(ctx, "quiz."+q.Result.Cat+".deals") }</h2>
						<p>{ tr(ctx, "quiz.list_note", "market", q.Result.Market) }</p>
					</div>
				</div>
				@dealList(q.Result.Cards, q.Result.Labels, q.Result.Title)
			</section>
		}
	}
}

// BlackFriday checks today's sales: real drops against the store's claims.
templ BlackFriday(p Page, counts []MarketCount, lists []DealsBlock) {
	@Layout(p, pageHead([]NavLink{{Name: tr(ctx, "nav.home"), URL: homeURL(p)}, {Name: "Black Friday"}}, tr(ctx, "bf.title"),
		tr(ctx, "bf.lede"))) {
		<section class="bf-counts">
			for _, m := range counts {
				<a class="card bf-card" href={ templ.SafeURL(m.URL) }>
					<span class="bf-market">{ m.Market }</span>
					<span class="bf-num green">{ i18n.Number(i18n.Lang(ctx), m.Drops) } <small>{ tr(ctx, "bf.drops") }</small></span>
					<span class="bf-num amber">{ i18n.Number(i18n.Lang(ctx), m.Sales) } <small>{ tr(ctx, "bf.sales") }</small></span>
				</a>
			}
		</section>
		<section class="card bf-how">
			<h2>{ tr(ctx, "bf.how") }</h2>
			<ul class="careful">
				for _, s := range []string{"green", "amber", "raised"} {
					<li>
						@trh(ctx, "bf.how."+s)
					</li>
				}
			</ul>
		</section>
		for _, l := range lists {
			<section class="section">
				<div class="section-head">
					<div>
						<h2>{ l.Title }</h2>
						<p>{ tr(ctx, "bf.today", "n", i18n.Number(i18n.Lang(ctx), l.Count)) }</p>
					</div>
					<a class="btn btn-ghost" href={ templ.SafeURL(l.URL) }>
						{ tr(ctx, "bf.see_all") }
						@icon("arrow-right")
					</a>
				</div>
				if len(l.Cards) == 0 {
					<div class="card empty"><p>{ tr(ctx, "bf.none") }</p></div>
				} else {
					@dealList(l.Cards, l.Labels, l.Title)
				}
			</section>
		}
	}
}

// Cheapest is a market's coffees by price per kg, cheapest first.
templ Cheapest(p Page, market string, l DealsBlock) {
	@Layout(p, pageHead([]NavLink{{Name: tr(ctx, "nav.home"), URL: homeURL(p)}, {Name: tr(ctx, "cheapest.crumb")}}, tr(ctx, "cheapest.title", "market", market),
		tr(ctx, "cheapest.lede", "market", market))) {
		<section class="card note-card">
			<p>
				@trh(ctx, "cheapest.note")
			</p>
		</section>
		<section class="section">
			<div class="section-head">
				<div>
					<h2>{ l.Title }</h2>
					<p>{ tr(ctx, "cheapest.first", "n", i18n.Number(i18n.Lang(ctx), l.Count)) }</p>
				</div>
				<a class="btn btn-ghost" href={ templ.SafeURL(l.URL) }>
					{ tr(ctx, "cheapest.whole") }
					@icon("arrow-right")
				</a>
			</div>
			@dealList(l.Cards, l.Labels, tr(ctx, "cheapest.aria"))
		</section>
	}
}
