package views

import "github.com/alparslanakbas/cupproof/internal/i18n"

// SiteFacts are the live numbers some information pages show.
type SiteFacts struct {
	Stores int
	Listed int64 // offers in stock across the markets
}

// Info is one of the information pages, by its slug.
templ Info(p Page, slug, title string, f SiteFacts) {
	@Layout(p, pageHead([]NavLink{{Name: tr(ctx, "nav.home"), URL: homeURL(p)}, {Name: title}}, title, tr(ctx, "info."+slug+".lede"))) {
		<article class="prose card">
			switch slug {
				case "how-it-works":
					@howItWorks()
				case "about":
					@about(f)
				case "contact":
					@contact()
				case "glossary":
					@glossary()
				case "privacy":
					@sections("privacy", privacySections)
				case "cookies":
					@cookies()
				case "terms":
					@sections("terms", termsSections)
			}
		</article>
	}
}

// The texts below say only what the site does: they were checked against
// it as it runs (5 Nov 2026). Change the site, change the text, in every
// language. Each part is "<page>.<part>.h" and "<page>.<part>.p" in the
// catalog; the parts' order is here.

var howSteps = []string{"read", "keep", "usual", "green", "amber", "converted", "list", "categories"}

templ howItWorks() {
	<ol class="steps">
		for _, s := range howSteps {
			<li>
				<h2>{ tr(ctx, "how."+s+".h") }</h2>
				<p>
					@trh(ctx, "how."+s+".p")
				</p>
			</li>
		}
	</ol>
}

templ about(f SiteFacts) {
	<p>{ tr(ctx, "about.p") }</p>
	if f.Stores > 0 {
		<div class="fact-row">
			<div class="stat"><p class="stat-label">{ tr(ctx, "about.stores") }</p><p class="stat-value">{ i18n.Number(i18n.Lang(ctx), int64(f.Stores)) }</p></div>
			<div class="stat"><p class="stat-label">{ tr(ctx, "about.offers") }</p><p class="stat-value">{ i18n.Number(i18n.Lang(ctx), f.Listed) }</p><p class="stat-note">{ tr(ctx, "about.offers_note") }</p></div>
		</div>
	}
	for _, s := range []string{"independent", "sisters", "since"} {
		<h2>{ tr(ctx, "about."+s+".h") }</h2>
		<p>
			@trh(ctx, "about."+s+".p")
		</p>
	}
	<p><a class="link" href={ templ.SafeURL(lp(ctx, "/how-it-works")) }>{ tr(ctx, "footer.how_it_works") }</a> · <a class="link" href={ templ.SafeURL(lp(ctx, "/contact")) }>{ tr(ctx, "footer.contact") }</a></p>
}

templ contact() {
	<p class="contact-mail">
		@icon("mail")
		<a class="link" href="mailto:support@wheyproof.com">support@wheyproof.com</a>
	</p>
	<p>{ tr(ctx, "contact.shared") }</p>
	for _, s := range []string{"wrong", "store", "else"} {
		<h2>{ tr(ctx, "contact."+s+".h") }</h2>
		<p>
			@trh(ctx, "contact."+s+".p")
		</p>
	}
}

// glossaryGroups are the glossary's sections and their terms, in order:
// "glossary.<term>.t" is a term, "glossary.<term>.d" its definition.
var glossaryGroups = []struct {
	head  string
	terms []string
}{
	{"kind.coffee.nav", []string{"arabica", "robusta", "single_origin", "blend", "washed", "natural", "honey", "roast_level",
		"espresso_roast", "decaf", "gesha", "whole_bean"}},
	{"kind.tea.nav", []string{"camellia", "black", "green", "oolong", "white", "puerh", "matcha", "chai", "herbal"}},
	{"glossary.prices", []string{"usual", "real_drop", "lowest30", "store_sale", "per_unit"}},
}

templ glossary() {
	for _, g := range glossaryGroups {
		<h2>{ tr(ctx, g.head) }</h2>
		<dl class="terms">
			for _, t := range g.terms {
				<div><dt>{ tr(ctx, "glossary."+t+".t") }</dt><dd>{ tr(ctx, "glossary."+t+".d") }</dd></div>
			}
		</dl>
	}
}

var privacySections = []string{"who", "none", "log", "cloudflare", "photos", "cookies", "rights"}

var termsSections = []string{"prices", "badges", "buying", "names", "guides", "changes"}

// sections is a legal page: headings and paragraphs, in order. A paragraph
// may link another page: {cookies} and {contact} are their addresses in the
// page's language.
templ sections(page string, parts []string) {
	for _, s := range parts {
		<h2>{ tr(ctx, page+"."+s+".h") }</h2>
		<p>
			@trh(ctx, page+"."+s+".p", "cookies", lp(ctx, "/cookies"), "contact", lp(ctx, "/contact"))
		</p>
	}
}

var cookieRows = []string{"theme", "watch", "compare"}

templ cookies() {
	<div class="compare-scroll">
		<table class="compare-table cookie-table">
			<thead><tr><th scope="col">{ tr(ctx, "cookies.col.cookie") }</th><th scope="col">{ tr(ctx, "cookies.col.what") }</th><th scope="col">{ tr(ctx, "cookies.col.when") }</th><th scope="col">{ tr(ctx, "cookies.col.kept") }</th></tr></thead>
			<tbody>
				for _, c := range cookieRows {
					<tr><th scope="row">{ c }</th><td>{ tr(ctx, "cookies."+c+".what") }</td><td>{ tr(ctx, "cookies."+c+".when") }</td><td>{ tr(ctx, "cookies.year") }</td></tr>
				}
			</tbody>
		</table>
	</div>
	<p>{ tr(ctx, "cookies.p1") }</p>
	<p>{ tr(ctx, "cookies.p2") }</p>
}
