package views

import "fmt"

// BrandCard is one store on the brands index and under "other stores".
type BrandCard struct {
	URL      string
	Name     string
	Monogram string
	Tone     int    // 1-6: the badge colour, fixed per store
	Country  string // "Germany"; "" when the store didn't say
	Count    string // "12 coffees on today's US list"
	Drops    int64  // coffees at a real drop today
	Sales    int64  // coffees with the store's own crossed-out price
}

// Brands is one market's brands index.
type Brands struct {
	Market    string // "US"
	Roasters  []BrandCard
	TeaHouses []BrandCard
}

// Fact is one line of a brand page's "About".
type Fact struct {
	Label, Value string
}

// Brand is one store's page in one market.
type Brand struct {
	Name      string
	Monogram  string
	Tone      int
	Market    string // "US"
	Kind      string // "coffee" or "tea"
	Noun      string // "coffees" or "teas"
	StoreURL  string
	BrandsURL string
	Coffees   int64
	Drops     int64
	Sales     int64
	Best      string // lowest price per kg (per 100 g for tea)
	BestLabel string
	About     []Fact
	RateNote  string // set when the store prices in another currency than the market's
	Deals     Deals
	Labels    Labels
	Others    []BrandCard
}

templ monoBadge(text string, tone int, big bool) {
	<span class={ "mono", fmt.Sprintf("tone-%d", tone), templ.KV("mono-lg", big) } aria-hidden="true">{ text }</span>
}

templ brandCardView(c BrandCard) {
	<a class="brand-card" href={ templ.SafeURL(c.URL) }>
		<span class="brand-top">
			@monoBadge(c.Monogram, c.Tone, false)
			<span class="brand-arrow">@icon("caret-right")</span>
		</span>
		<h3>{ c.Name }</h3>
		<span class="brand-meta">{ c.Count }</span>
		if c.Country != "" {
			<span class="brand-meta">{ tr(ctx, "brand.based_in_value", "country", c.Country) }</span>
		}
		<span class="badges">
			if c.Drops > 0 {
				<span class="badge badge-green">{ trn(ctx, "count.real_drops", c.Drops) }</span>
			} else if c.Sales > 0 {
				<span class="badge badge-amber">{ trn(ctx, "count.store_sales", c.Sales) }</span>
			} else {
				<span class="badge">{ tr(ctx, "brands.no_badge") }</span>
			}
		</span>
	</a>
}

templ brandsHero(b Brands) {
	<section class="wrap">
		<div class="page-hero">
			<div>
				<nav class="crumbs" aria-label={ tr(ctx, "nav.breadcrumb") }><a href="/">{ tr(ctx, "nav.home") }</a><span>/</span><span>{ tr(ctx, "nav.brands") }</span></nav>
				<h1>{ tr(ctx, "nav.stores") }</h1>
				<p class="lede">{ tr(ctx, "brands.lede", "market", b.Market) }</p>
			</div>
			<nav class="toggle" aria-label={ tr(ctx, "brands.jump") }>
				<a href="#roasters">{ tr(ctx, "brands.roasters") }</a>
				<a href="#tea-houses">{ tr(ctx, "brands.tea_houses") }</a>
			</nav>
		</div>
	</section>
}

templ BrandsIndex(p Page, b Brands) {
	@Layout(p, brandsHero(b)) {
		<p class="legend"><span><span class="dot dot-green"></span>{ tr(ctx, "brands.legend_order") }</span><span>{ tr(ctx, "brands.legend_counts") }</span></p>
		<section class="brand-section" id="roasters">
			<h2>{ tr(ctx, "brands.roasters_n", "n", fmt.Sprint(len(b.Roasters))) }</h2>
			if len(b.Roasters) == 0 {
				<div class="empty">{ tr(ctx, "brands.no_roaster") }</div>
			} else {
				<div class="brand-grid">
					for _, c := range b.Roasters {
						@brandCardView(c)
					}
				</div>
			}
		</section>
		<section class="brand-section" id="tea-houses">
			<h2>{ tr(ctx, "brands.tea_houses_n", "n", fmt.Sprint(len(b.TeaHouses))) }</h2>
			if len(b.TeaHouses) == 0 {
				<div class="empty">{ tr(ctx, "brands.no_tea_house") }</div>
			} else {
				<div class="brand-grid">
					for _, c := range b.TeaHouses {
						@brandCardView(c)
					}
				</div>
			}
		</section>
	}
}

templ brandHero(b Brand) {
	<section class="wrap">
		<div class="brand-hero">
			<div class="brand-hero-main">
				<nav class="crumbs" aria-label={ tr(ctx, "nav.breadcrumb") }><a href="/">{ tr(ctx, "nav.home") }</a><span>/</span><a href={ templ.SafeURL(b.BrandsURL) }>{ tr(ctx, "nav.brands") }</a><span>/</span><span>{ b.Name }</span></nav>
				@monoBadge(b.Monogram, b.Tone, true)
				<h1>{ tr(ctx, "brand.heading", "store", b.Name) }</h1>
				<p class="lede">{ tr(ctx, "brand.lede", "store", b.Name, "market", b.Market) }</p>
				<div class="actions">
					<a class="btn btn-primary" href={ templ.SafeURL(b.StoreURL) } rel="nofollow">
						{ tr(ctx, "brand.visit", "store", b.Name) }
						@icon("external")
					</a>
				</div>
			</div>
			<div class="tiles">
				<p class="tiles-note"><span class="dot dot-green"></span>{ tr(ctx, "brand.on_list", "market", b.Market) }</p>
				<div class="tile"><span>{ tr(ctx, "brand.in_stock") }</span><b>{ trn(ctx, "kind."+b.Kind+".count", b.Coffees) }</b></div>
				<div class={ "tile", templ.KV("tile-green", b.Drops > 0) }><span>{ tr(ctx, "brand.real_drops") }</span><b>{ fmt.Sprint(b.Drops) }</b></div>
				<div class={ "tile", templ.KV("tile-amber", b.Sales > 0) }><span>{ tr(ctx, "brand.store_sales") }</span><b>{ fmt.Sprint(b.Sales) }</b></div>
				<div class="tile"><span>{ b.BestLabel }</span><b>{ b.Best }</b></div>
			</div>
		</div>
	</section>
}

templ BrandPage(p Page, b Brand) {
	@Layout(p, brandHero(b)) {
		<section class="brand-list">
			<h2>{ tr(ctx, "brand.store_on_list", "store", b.Name, "market", b.Market) }</h2>
			@dealsSection(b.Deals)
		</section>
		<section class="section">
			<div class="card about-card">
				<h2>{ tr(ctx, "kind."+b.Kind+".about") }</h2>
				<dl class="facts">
					for _, f := range b.About {
						<div><dt>{ f.Label }</dt><dd>{ f.Value }</dd></div>
					}
				</dl>
				if b.RateNote != "" {
					<p class="fineprint">{ b.RateNote }</p>
				}
			</div>
		</section>
		if len(b.Others) > 0 {
			<section class="section">
				<div class="section-head">
					<h2>{ tr(ctx, "brand.others") }</h2>
					<a class="btn btn-ghost" href={ templ.SafeURL(b.BrandsURL) }>{ tr(ctx, "brand.all") }</a>
				</div>
				<div class="brand-grid">
					for _, c := range b.Others {
						@brandCardView(c)
					}
				</div>
			</section>
		}
	}
}
