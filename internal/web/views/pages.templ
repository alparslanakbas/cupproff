package views

import "fmt"

// MarketLink is one entry of the region selector.
type MarketLink struct {
	Name string
	URL  string
}

templ Home(p Page, markets []MarketLink) {
	@Layout(p) {
		<h1>Choose your country</h1>
		<p class="lede">Prices differ by country, so every country has its own pages.</p>
		<ul class="markets">
			for _, m := range markets {
				<li><a href={ templ.SafeURL(m.URL) }>{ m.Name }</a></li>
			}
		</ul>
	}
}

// Card is one coffee in a market listing.
type Card struct {
	URL       string
	Title     string
	Roaster   string
	ImageURL  string
	Size      string
	Price     string
	PerKilo   string
	StoreWas  string
	Available bool
}

templ MarketHome(p Page, heading string, cards []Card) {
	@Layout(p) {
		<h1>{ heading }</h1>
		<p class="lede">{ fmt.Sprintf("%d coffees from independent roasters, with the price each one shows today.", len(cards)) }</p>
		<ul class="cards">
			for _, c := range cards {
				<li class="card">
					<a href={ templ.SafeURL(c.URL) }>
						if c.ImageURL != "" {
							<img src={ c.ImageURL } alt="" width="320" height="320" loading="lazy"/>
						}
						<span class="card-title">{ c.Title }</span>
					</a>
					<span class="muted">{ c.Roaster } · { c.Size }</span>
					<span class="price-row">
						<span class="price">{ c.Price }</span>
						if c.PerKilo != "" {
							<span class="muted">{ c.PerKilo }</span>
						}
					</span>
					if c.StoreWas != "" {
						<span class="badge campaign">Store sale · was { c.StoreWas }</span>
					}
					if !c.Available {
						<span class="badge out">Out of stock</span>
					}
				</li>
			}
		</ul>
	}
}

// Offer is one bag size on a coffee page.
type Offer struct {
	Size      string
	Price     string
	PerKilo   string
	StoreWas  string
	RealDrop  int
	Usual     string
	Low30     string
	Available bool
	BuyURL    string
}

// Coffee is a coffee page.
type Coffee struct {
	Title      string
	Roaster    string
	RoasterURL string
	ImageURL   string
	BackURL    string
	Offers     []Offer
}

templ CoffeePage(p Page, c Coffee) {
	@Layout(p) {
		<nav class="crumbs"><a href={ templ.SafeURL(c.BackURL) }>All coffees</a> / { c.Roaster }</nav>
		<article class="coffee">
			if c.ImageURL != "" {
				<img class="coffee-img" src={ c.ImageURL } alt={ c.Title } width="480" height="480"/>
			}
			<div>
				<h1>{ c.Title }</h1>
				<p class="muted">Roasted by <a href={ templ.SafeURL(c.RoasterURL) } rel="nofollow">{ c.Roaster }</a></p>
				<table class="offers">
					<thead><tr><th>Bag</th><th>Price</th><th>Per kg</th><th>Verdict</th><th></th></tr></thead>
					<tbody>
						for _, o := range c.Offers {
							<tr>
								<td>{ o.Size }</td>
								<td class="price">{ o.Price }</td>
								<td class="muted">{ o.PerKilo }</td>
								<td>
									if o.RealDrop > 0 {
										<span class="badge real">{ fmt.Sprintf("Real drop −%d%%", o.RealDrop) }</span>
										<span class="muted small">usual { o.Usual }</span>
									} else if o.Usual == "" {
										<span class="muted small">Not enough history yet</span>
									} else {
										<span class="muted small">At its usual price</span>
									}
									if o.StoreWas != "" {
										<span class="badge campaign">Store says was { o.StoreWas }</span>
									}
									if !o.Available {
										<span class="badge out">Out of stock</span>
									}
								</td>
								<td><a class="buy" href={ templ.SafeURL(o.BuyURL) } rel="nofollow">Go to roaster</a></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</article>
	}
}

templ NotFound(p Page, homeURL string) {
	@Layout(p) {
		<h1>Page not found</h1>
		<p class="lede">This coffee or page doesn't exist, or the roaster stopped selling it.</p>
		<p><a href={ templ.SafeURL(homeURL) }>See all coffees</a></p>
	}
}
