package views

import "fmt"

// Card is one coffee or tea in a list: the sister sites' product row.
type Card struct {
	URL          string
	Title        string
	Roaster      string
	RoasterURL   string // the store's page here; "" when unknown
	ImageURL     string
	Size         string
	Price        string
	PerUnit      string // per kg for coffee, per 100 g for tea
	Usual        string // our usual price, "" until there is enough history
	Low30        string
	Lower        bool   // today's price is under the usual one, by any amount
	Saved        string // usual minus today, shown with a real drop
	RealDrop     int
	StoreWas     string
	StorePercent int // the store's own discount, from its "was" price
	LowestIn30   bool
	LowestSince  string
	OutOfStock   bool
	Chart        string // inline SVG, "" with fewer than two readings
	Reading      string // one sentence: what today's price means
	BuyURL       string
	Checked      string // when the store's prices were last read
	StoreNote    string // "The roaster's own shop"
	Market       string // "US": on the watchlist and the comparison
	Ref          string // "en-us/coffee/slug"
	Watched      bool
	Compared     bool
	WatchURL     string
	CompareURL   string
}

// Pager links the pages of a list with plain, crawlable links.
type Pager struct {
	Page, Pages int
	Total       int
	PrevURL     string
	NextURL     string
	Items       []PageItem
}

// PageItem is a page number of the pager, or a gap between numbers.
type PageItem struct {
	N       int
	URL     string
	Current bool
	Gap     bool
}

// Option is one choice of a select.
type Option struct {
	Value    string
	Label    string
	Selected bool
}

// Deals is a list with the sister sites' controls: the view switch, the
// store, category and order selects, the active filters and the pages.
type Deals struct {
	Action     string // the list's address: the controls submit here
	Show       string
	Query      string
	Views      []NavLink
	ViewNote   string
	Roasters   []Option // empty on a store's own page
	Categories []Option
	Sorts      []Option
	Chips      []NavLink // active filters, each with the link that removes it
	ClearURL   string
	Cards      []Card
	Total      int64
	Pager      Pager
	Labels     Labels
	Elsewhere  *NavLink // a search with nothing here, in the other section
	MoreURL    string   // the home page: one link to the full list instead of pages
	MoreLabel  string
}

// Hero is the band's text and today's top deal.
type Hero struct {
	Crumbs    []NavLink
	Heading   string
	Lede      string
	Tracked   string
	Count     int64
	LastCheck string
	Currency  string
	Top       *Card
	TopChart  string
	Labels    Labels
}

// Listing is a list page: the home page and every market's sections.
type Listing struct {
	Hero  Hero
	Deals Deals
}

// Offer is one size on a coffee or tea page.
type Offer struct {
	Size        string
	Price       string
	Amount      string // the price as a plain number, for the cost calculator
	Grams       int32
	PerUnit     string
	StoreWas    string
	RealDrop    int
	Usual       string
	LowestIn30  bool   // the window's lowest price and below the usual price
	LowestSince string // set when it is also the lowest since tracking began (30+ days)
	Available   bool
	BuyURL      string
	Chart       string // inline SVG from sparkline, "" when there is no history yet
	Big         string // the history card's chart, same rule
	Since       string // date of the first reading
	High, Low   string // the highest and lowest price in the chart's window
	Anchor      string
	Reading     string
	Today       string
	Low30       string
	Against     string // today against the usual price, signed
	AgainstNote string
	Lower       bool
	RateNote    string // why a lower converted price is no drop; "" otherwise
}

// Coffee is a coffee or tea page; the labels are the words that differ.
type Coffee struct {
	Title      string
	Roaster    string
	RoasterURL string
	ImageURL   string
	BackURL    string
	Section    string // "US coffee"
	Checked    string
	Offers     []Offer
	Featured   int // index of the size the page opens on
	Labels     Labels
	Kind       string
	Ref        string
	Watched    bool
	Compared   bool
	WatchURL   string
	CompareURL string
}

// Labels are the words a coffee page and a tea page say differently.
type Labels struct {
	Back      string // "All coffees"
	Maker     string // "Roasted by"
	Size      string // "Bag"
	Unit      string // "Per kg"
	Buy       string // "Go to roaster"
	StoreNote string // "The roaster's own shop"
}

// verdictClass colors the verdict box like the badge it explains.
func verdictClass(o Offer) string {
	switch {
	case !o.Available:
		return "verdict"
	case o.RealDrop > 0:
		return "verdict verdict-green"
	case o.StoreWas != "":
		return "verdict verdict-amber"
	}
	return "verdict"
}

func verdictTitle(o Offer) string {
	switch {
	case !o.Available:
		return "Out of stock"
	case o.LowestSince != "":
		return "Lowest since " + o.LowestSince
	case o.LowestIn30:
		return "Lowest in 30 days"
	case o.RealDrop > 0:
		return fmt.Sprintf("Real drop −%d%%", o.RealDrop)
	case o.StoreWas != "":
		return "Store sale, not a real drop"
	case o.RateNote != "":
		return o.RateNote
	case o.Usual == "":
		return "Too new to judge"
	}
	return "No deal today"
}

// orDash is a figure or "—" when there is none (never a guess).
func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// dealBadge is a row's one badge, as on the sister sites: a real drop in
// green, else the store's own sale in amber; out of stock beside it.
templ dealBadge(c Card) {
	if c.LowestSince != "" {
		<span class="badge badge-green">Lowest since { c.LowestSince }</span>
	} else if c.LowestIn30 {
		<span class="badge badge-green">Lowest in 30 days</span>
	} else if c.RealDrop > 0 {
		<span class="badge badge-green">{ fmt.Sprintf("Real drop −%d%%", c.RealDrop) }</span>
	} else if c.StorePercent > 0 {
		<span class="badge badge-amber">{ fmt.Sprintf("Store sale −%d%%", c.StorePercent) }</span>
	}
	if c.OutOfStock {
		<span class="badge">Out of stock</span>
	}
}

// productRow is the sister sites' product row: image, name, price, chart,
// store.
templ productRow(c Card, labels Labels) {
	<article class="deal-row">
		<a class="deal-img" href={ templ.SafeURL(c.URL) } tabindex="-1" aria-hidden="true">
			if c.ImageURL != "" {
				<img src={ c.ImageURL } alt="" width="240" height="240" loading="lazy" decoding="async"/>
			}
			<span class="img-brand">{ c.Roaster }</span>
		</a>
		<div class="deal-details">
			<div class="badges">
				@dealBadge(c)
			</div>
			<a class="deal-title" href={ templ.SafeURL(c.URL) }>
				<h3 title={ c.Title }>{ c.Title }</h3>
				<p>
					{ c.Roaster }
					if c.Size != "" {
						{ " · " + c.Size }
					}
					if c.Market != "" {
						{ " · " + c.Market }
					}
				</p>
			</a>
			<div class="deal-meta">
				<span class="tracked">
					@icon("seal")
					Price history tracked
				</span>
				if c.Checked != "" {
					<span>{ c.Checked }</span>
				}
				if c.CompareURL != "" {
					<a href={ templ.SafeURL(c.CompareURL) } rel="nofollow">
						if c.Compared {
							@icon("check")
							Added to comparison
						} else {
							@icon("scales")
							Compare
						}
					</a>
				}
			</div>
		</div>
		<div class="deal-price">
			<div class="amount">{ c.Price }</div>
			if c.Saved != "" {
				<div class="was"><s>{ c.Usual }</s></div>
				<div class="save-row"><span class="save-pill">{ fmt.Sprintf("%d%%", c.RealDrop) }</span><span>You save { c.Saved }</span></div>
			} else if c.StorePercent > 0 {
				<div class="was"><s>{ c.StoreWas }</s></div>
				<div class="save-row"><span class="badge badge-amber">{ fmt.Sprintf("%d%% off at the store", c.StorePercent) }</span></div>
			}
			if c.PerUnit != "" {
				<div class="unit">{ c.PerUnit }</div>
			}
		</div>
		<div class="deal-chart">
			if c.Chart != "" {
				@templ.Raw(c.Chart)
			} else {
				<span class="nochart">History starts today</span>
			}
			<a class="history-link" href={ templ.SafeURL(c.URL) }>
				See price history
				@icon("arrow-right")
			</a>
		</div>
		<div class="deal-store">
			<div class="store-name">{ c.Roaster }</div>
			<div class="store-type">{ c.StoreNote }</div>
			<a class="btn btn-primary" href={ templ.SafeURL(c.BuyURL) } rel="nofollow">
				{ labels.Buy }
				@icon("external")
			</a>
			if c.CompareURL != "" {
				<a class="btn btn-ghost btn-small" href={ templ.SafeURL(c.CompareURL) } rel="nofollow">
					if c.Compared {
						@icon("check")
						Added
					} else {
						@icon("scales")
						Compare
					}
				</a>
			}
		</div>
	</article>
}

// dealList is a list of rows in one card.
templ dealList(cards []Card, labels Labels, label string) {
	<section class="deal-list" aria-label={ label }>
		for _, c := range cards {
			@productRow(c, labels)
		}
	</section>
}

// heroBand is the band's left column and today's top deal.
templ heroBand(h Hero) {
	<section class="wrap hero-grid">
		<div class="hero-text">
			if len(h.Crumbs) > 0 {
				@crumbs(h.Crumbs)
			}
			<h1>{ h.Heading }</h1>
			if h.Lede != "" {
				<p class="lede">{ h.Lede }</p>
			}
			<div class="hero-stats">
				if h.Tracked != "" {
					<span>
						@icon("shield")
						{ h.Tracked }
					</span>
				}
				if h.LastCheck != "" {
					<span><i class="live-dot" aria-hidden="true"></i>Last check { h.LastCheck }</span>
				}
				if h.Currency != "" {
					<span>{ h.Currency }</span>
				}
			</div>
		</div>
		if h.Top != nil {
			@featuredDeal(*h.Top, h.TopChart, h.Labels)
		}
	</section>
}

templ crumbs(links []NavLink) {
	<nav class="crumbs" aria-label="Breadcrumb">
		for i, l := range links {
			if i > 0 {
				<span aria-hidden="true">/</span>
			}
			if i == len(links)-1 {
				<span>{ l.Name }</span>
			} else {
				<a href={ templ.SafeURL(l.URL) }>{ l.Name }</a>
			}
		}
	</nav>
}

// featuredDeal is the band's "Today's top deal" card.
templ featuredDeal(c Card, chart string, labels Labels) {
	<article class="featured">
		<a class="featured-img" href={ templ.SafeURL(c.URL) } tabindex="-1" aria-hidden="true">
			if c.ImageURL != "" {
				<img src={ c.ImageURL } alt="" width="240" height="240" decoding="async"/>
			}
		</a>
		<a class="featured-info" href={ templ.SafeURL(c.URL) }>
			<span class="kicker">Today's top deal</span>
			<h2>{ c.Title }</h2>
			<p class="featured-meta">{ c.Roaster } · { c.Size }</p>
			<p class="checked">
				@icon("seal")
				Checked against price history
			</p>
		</a>
		<div class="featured-price">
			if c.LowestSince != "" {
				<span class="badge badge-green">Lowest since { c.LowestSince }</span>
			} else if c.LowestIn30 {
				<span class="badge badge-green">Lowest in 30 days</span>
			}
			<div class="featured-amount">{ c.Price }</div>
			if c.Saved != "" {
				<div class="save-row"><span class="save-pill">{ fmt.Sprintf("%d%%", c.RealDrop) }</span><span>You save { c.Saved }</span></div>
			} else if c.StorePercent > 0 {
				<div class="save-row"><span class="badge badge-amber">{ fmt.Sprintf("Store sale %d%%", c.StorePercent) }</span></div>
			}
		</div>
		<div class="featured-chart">
			if chart != "" {
				@templ.Raw(chart)
			} else {
				<p>Price history is still building up. The chart will appear here as it grows.</p>
			}
		</div>
		<div class="featured-actions">
			<a class="btn btn-primary" href={ templ.SafeURL(c.BuyURL) } rel="nofollow">
				{ labels.Buy }
				@icon("external")
			</a>
			<a class="btn btn-outline" href={ templ.SafeURL(c.URL) }>View price history</a>
		</div>
	</article>
}

// dealsSection is a list with the sister sites' controls. The controls are a
// GET form (the "Filter" button applies the selects) and links.
templ dealsSection(d Deals) {
	<section class="deals" id="products">
		<form class="deal-controls" method="get" action={ templ.SafeURL(d.Action) }>
			<div class="view-wrap">
				<nav class="view-switch" aria-label="View">
					for _, v := range d.Views {
						if v.Current {
							<a href={ templ.SafeURL(v.URL) } aria-current="page">{ v.Name }</a>
						} else {
							<a href={ templ.SafeURL(v.URL) }>{ v.Name }</a>
						}
					}
				</nav>
				<p class="view-note">{ d.ViewNote }</p>
			</div>
			<div class="filter-row">
				if d.Show != "" {
					<input type="hidden" name="show" value={ d.Show }/>
				}
				if d.Query != "" {
					<input type="hidden" name="q" value={ d.Query }/>
				}
				<button class="btn btn-ghost" type="submit">
					@icon("funnel")
					Filter
				</button>
				if d.ClearURL != "" {
					<a class="btn btn-ghost" href={ templ.SafeURL(d.ClearURL) }>Clear filters</a>
				}
				if len(d.Roasters) > 0 {
					@selectBox("roaster", "Filter by store", d.Roasters)
				}
				@selectBox("cat", "Filter by category", d.Categories)
				@selectBox("sort", "Sort products", d.Sorts)
			</div>
		</form>
		if len(d.Chips) > 0 {
			<div class="chips-row">
				for _, c := range d.Chips {
					<a class="filter-chip" href={ templ.SafeURL(c.URL) }>
						{ c.Name }
						@icon("x")
						<span class="sr-only">remove</span>
					</a>
				}
			</div>
		}
		if len(d.Cards) == 0 {
			<div class="card empty">
				@icon("search")
				<h2>No products in this view</h2>
				<p>Try clearing the filters or switching to another view.</p>
				if d.Elsewhere != nil {
					<p><a class="link" href={ templ.SafeURL(d.Elsewhere.URL) }>{ d.Elsewhere.Name }</a></p>
				}
				if d.ClearURL != "" {
					<a class="btn btn-primary" href={ templ.SafeURL(d.ClearURL) }>Clear filters</a>
				}
			</div>
		} else {
			@dealList(d.Cards, d.Labels, "Products")
			if d.MoreURL != "" {
				<p class="more-row">
					<a class="btn btn-primary" href={ templ.SafeURL(d.MoreURL) }>
						{ d.MoreLabel }
						@icon("arrow-right")
					</a>
				</p>
			} else if d.Pager.Pages > 1 {
				@pagerNav(d.Pager)
			}
		}
	</section>
}

templ selectBox(name, label string, options []Option) {
	<select class="filter-control" name={ name } aria-label={ label }>
		for _, o := range options {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}

// pagerNav is the sister sites' numbered page row.
templ pagerNav(p Pager) {
	<nav class="pager" aria-label="Pagination">
		if p.PrevURL != "" {
			<a class="pager-btn" href={ templ.SafeURL(p.PrevURL) } rel="prev" aria-label="Previous page">
				@icon("caret-left")
			</a>
		} else {
			<span class="pager-btn off" aria-hidden="true">
				@icon("caret-left")
			</span>
		}
		for _, it := range p.Items {
			if it.Gap {
				<span class="pager-gap" aria-hidden="true">…</span>
			} else if it.Current {
				<span class="pager-btn current" aria-current="page">{ fmt.Sprint(it.N) }</span>
			} else {
				<a class="pager-btn" href={ templ.SafeURL(it.URL) } aria-label={ fmt.Sprintf("Page %d", it.N) }>{ fmt.Sprint(it.N) }</a>
			}
		}
		if p.NextURL != "" {
			<a class="pager-btn" href={ templ.SafeURL(p.NextURL) } rel="next" aria-label="Next page">
				@icon("caret-right")
			</a>
		} else {
			<span class="pager-btn off" aria-hidden="true">
				@icon("caret-right")
			</span>
		}
	</nav>
	<p class="pager-note">{ fmt.Sprintf("Page %d of %d · %d products", p.Page, p.Pages, p.Total) }</p>
}

// Home is the sister sites' home page: the band, the strip, the US list,
// the guides and the questions.
templ Home(p Page, l Listing) {
	@Layout(p, heroBand(l.Hero)) {
		@dealsSection(l.Deals)
		@guidesTeaser()
		@faq()
	}
}

// MarketHome is a market's list of one section, or of one category.
templ MarketHome(p Page, l Listing) {
	@Layout(p, heroBand(l.Hero)) {
		@dealsSection(l.Deals)
	}
}

// faq is the home page's questions, from the rules the site runs on.
templ faq() {
	<section class="faq" id="faq">
		<div class="section-center">
			<span class="kicker">Transparency</span>
			<h2>Frequently asked questions</h2>
		</div>
		<div class="faq-list">
			<details class="card faq-item">
				<summary>
					How do you decide that a price really dropped?
					@icon("caret-down")
				</summary>
				<p>We read every price once a day and keep the history. A product's usual price is the highest price it sold for on at least 7 of the last 30 days. A price under it is a real drop; if no day in the last 30 was cheaper, it's the lowest in 30 days.</p>
			</details>
			<details class="card faq-item">
				<summary>
					What does a Store sale badge mean?
					@icon("caret-down")
				</summary>
				<p>The store shows its own crossed-out "was" price. We show it in amber and don't count it as a drop: a "was" price is the store's claim, our price history is the proof.</p>
			</details>
			<details class="card faq-item">
				<summary>
					Where do the prices come from?
					@icon("caret-down")
				</summary>
				<p>From each roaster's and tea house's own online shop, as a buyer in the US, the UK or the EU sees them. Shipping isn't included. Check the final price on the store's site before you buy.</p>
			</details>
			<details class="card faq-item">
				<summary>
					Why isn't a lower price in another currency always a drop?
					@icon("caret-down")
				</summary>
				<p>Some stores convert their prices for other countries. A converted price can move with the exchange rate alone, so we count it as a drop only when the store's price in its own currency dropped too.</p>
			</details>
			<details class="card faq-item">
				<summary>
					Do you sell coffee?
					@icon("caret-down")
				</summary>
				<p>No. CoffeeProof is independent: it reads prices and links to the store. Purchases happen on the store's own site.</p>
			</details>
		</div>
	</section>
}

templ productHero(c Coffee) {
	<section class="wrap band-crumbs">
		@crumbs([]NavLink{{Name: "Home", URL: "/"}, {Name: c.Section, URL: c.BackURL}, {Name: c.Roaster}})
	</section>
}

// sizeNoun is "250 g bag" (the label's word in lower case).
func sizeNoun(size, word string) string {
	if word == "" {
		return size
	}
	return size + " " + lower(word)
}

func lower(s string) string {
	b := []byte(s)
	for i, c := range b {
		if c >= 'A' && c <= 'Z' {
			b[i] = c + 32
		}
	}
	return string(b)
}

// CoffeePage is the sister sites' product sheet: the price analysis of each
// size, the size the visitor came for first.
templ CoffeePage(p Page, c Coffee) {
	@Layout(p, productHero(c)) {
		if len(c.Offers) > 0 {
			<article class="sheet">
				<header class="sheet-head">
					<span class="sheet-img">
						if c.ImageURL != "" {
							<img src={ c.ImageURL } alt={ c.Title } width="240" height="240"/>
						}
					</span>
					<div class="sheet-title">
						<p class="kicker">{ c.Roaster }</p>
						<h1>{ c.Title }</h1>
						<p class="sheet-checked">{ "Price checked " + c.Checked + " · " + c.Section }</p>
					</div>
					<div class="sheet-tools">
						<a class="icon-btn" href={ templ.SafeURL(c.WatchURL) } rel="nofollow" title="Watchlist">
							if c.Watched {
								@icon("bookmark-fill")
								<span class="sr-only">Remove from watchlist</span>
							} else {
								@icon("bookmark")
								<span class="sr-only">Add to watchlist</span>
							}
						</a>
					</div>
				</header>
				if len(c.Offers) > 1 {
					<nav class="size-tabs" aria-label="Sizes">
						for i, s := range c.Offers {
							<a
								href={ templ.SafeURL("#" + s.Anchor) }
								if i == c.Featured {
									aria-current="true"
								}
							>{ s.Size }</a>
						}
					</nav>
				}
				@sizeSheet(c, c.Offers[c.Featured])
				for i, s := range c.Offers {
					if i != c.Featured {
						@sizeSheet(c, s)
					}
				}
				<div class="sheet-actions">
					<a class="btn btn-ghost" href={ templ.SafeURL(c.WatchURL) } rel="nofollow">
						if c.Watched {
							@icon("bookmark-fill")
							On your watchlist
						} else {
							@icon("bookmark")
							Add to watchlist
						}
					</a>
					<a class="btn btn-ghost" href={ templ.SafeURL(c.CompareURL) } rel="nofollow">
						if c.Compared {
							@icon("check")
							Added to comparison
						} else {
							@icon("scales")
							Compare
						}
					</a>
					if c.Kind == "coffee" {
						{{ f := c.Offers[c.Featured] }}
						if f.Grams > 0 {
							<a class="btn btn-ghost" href={ templ.SafeURL(fmt.Sprintf("/calculators/cost-per-cup?price=%s&grams=%d", f.Amount, f.Grams)) }>
								@icon("calculator")
								Cost per cup
							</a>
						}
					}
				</div>
			</article>
		}
	}
}

// sizeSheet is one size's price analysis.
templ sizeSheet(c Coffee, s Offer) {
	<section class="sheet-size" id={ s.Anchor }>
		<div class="sheet-row">
			<div>
				<p class="kicker">Real price history</p>
				<h2>Price analysis <span>{ sizeNoun(s.Size, c.Labels.Size) }</span></h2>
			</div>
			<div class="sheet-price">
				<b>{ s.Price }</b>
				<span>Current price</span>
			</div>
		</div>
		if s.Big != "" {
			<div class="sheet-chart">
				@templ.Raw(s.Big)
			</div>
		} else {
			<p class="nochart">History starts today; the chart fills in from tomorrow.</p>
		}
		<div class="sheet-stats">
			<div><span>Period low</span><b>{ orDash(s.Low) }</b></div>
			<div class="current"><span>Current price</span><b>{ s.Price }</b></div>
			<div><span>Period high</span><b>{ orDash(s.High) }</b></div>
		</div>
		<div class={ verdictClass(s) }>
			<p class="verdict-title">{ verdictTitle(s) }</p>
			<p>{ s.Reading }</p>
		</div>
		<h3>What we measured about this product</h3>
		<dl class="measured">
			<div>
				<dt>Usual price we measured</dt>
				if s.Usual != "" {
					<dd>{ s.Usual } <span>the highest price on at least 7 of the last 30 days</span></dd>
				} else {
					<dd>Not enough history yet</dd>
				}
			</div>
			<div><dt>Since tracking started</dt><dd>{ orDash(s.Since) }</dd></div>
			<div><dt>Lowest in the last 30 days</dt><dd>{ orDash(s.Low30) }</dd></div>
			if s.Against != "" {
				<div><dt>Against the usual price</dt><dd>{ s.Against } <span>{ s.AgainstNote }</span></dd></div>
			}
			<div>
				<dt>What the store shows</dt>
				if s.StoreWas != "" {
					<dd>Was { s.StoreWas } <span>the store's claim, not our measurement</span></dd>
				} else {
					<dd>No sale price</dd>
				}
			</div>
			if s.PerUnit != "" {
				<div><dt>{ c.Labels.Unit }</dt><dd>{ s.PerUnit }</dd></div>
			}
			<div>
				<dt>Stock</dt>
				if s.Available {
					<dd>In stock at our last check</dd>
				} else {
					<dd>Out of stock at our last check. We keep tracking its price.</dd>
				}
			</div>
		</dl>
		<a class="btn btn-primary btn-block" href={ templ.SafeURL(s.BuyURL) } rel="nofollow">
			{ c.Labels.Buy }
			@icon("external")
		</a>
		<p class="sheet-note">{ "Checked " + c.Checked + ". " + c.Labels.StoreNote + " shows the final price." }</p>
	</section>
}

templ notFoundHero() {
	<section class="wrap hero-grid">
		<div class="hero-text">
			<h1>Page not found</h1>
			<p class="lede">This page doesn't exist, or the store stopped selling it.</p>
		</div>
	</section>
}

templ NotFound(p Page, homeURL string) {
	@Layout(p, notFoundHero()) {
		<div class="card empty">
			@icon("warning")
			<h2>Nothing here</h2>
			<p>Try the search above, or start from today's deals.</p>
			<a class="btn btn-primary" href={ templ.SafeURL(homeURL) }>Back to the home page</a>
		</div>
	}
}
