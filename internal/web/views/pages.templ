package views

import "fmt"

// MarketLink is one entry of the region selector.
type MarketLink struct {
	Name string
	URL  string
}

templ Home(p Page, markets []MarketLink) {
	@Layout(p) {
		<h1>Choose your country</h1>
		<p class="lede">Prices differ by country, so every country has its own pages.</p>
		<ul class="markets">
			for _, m := range markets {
				<li><a href={ templ.SafeURL(m.URL) }>{ m.Name }</a></li>
			}
		</ul>
	}
}

// Card is one coffee or tea in a market listing.
type Card struct {
	URL       string
	Title     string
	Roaster   string
	ImageURL  string
	Size      string
	Price     string
	PerUnit   string // per kg for coffee, per 100 g for tea
	StoreWas  string
	Available bool
	RealDrop    int
	LowestIn30  bool
	LowestSince string
}

// Pager links the pages of a listing with plain, crawlable links.
type Pager struct {
	Page, Pages int
	Total       int
	PrevURL     string
	NextURL     string
}

templ MarketHome(p Page, heading, lede string, cards []Card, pg Pager) {
	@Layout(p) {
		<h1>{ heading }</h1>
		<p class="lede">{ lede }</p>
		<ul class="cards">
			for _, c := range cards {
				<li class="card">
					<a href={ templ.SafeURL(c.URL) }>
						if c.ImageURL != "" {
							<img src={ c.ImageURL } alt="" width="320" height="320" loading="lazy"/>
						}
						<span class="card-title">{ c.Title }</span>
					</a>
					<span class="muted">{ c.Roaster } · { c.Size }</span>
					<span class="price-row">
						<span class="price">{ c.Price }</span>
						if c.PerUnit != "" {
							<span class="muted">{ c.PerUnit }</span>
						}
					</span>
					if c.LowestSince != "" {
						<span class="badge real">Lowest since { c.LowestSince }</span>
					} else if c.LowestIn30 {
						<span class="badge real">Lowest in 30 days</span>
					}
					if c.RealDrop > 0 {
						<span class="badge real">{ fmt.Sprintf("Real drop −%d%%", c.RealDrop) }</span>
					}
					if c.StoreWas != "" {
						<span class="badge campaign">Store sale · was { c.StoreWas }</span>
					}
					if !c.Available {
						<span class="badge out">Out of stock</span>
					}
				</li>
			}
		</ul>
		if pg.Pages > 1 {
			<nav class="pager" aria-label="Pages">
				if pg.PrevURL != "" {
					<a href={ templ.SafeURL(pg.PrevURL) } rel="prev">Previous</a>
				}
				<span class="muted">{ fmt.Sprintf("Page %d of %d", pg.Page, pg.Pages) }</span>
				if pg.NextURL != "" {
					<a href={ templ.SafeURL(pg.NextURL) } rel="next">Next</a>
				}
			</nav>
		}
	}
}

// Offer is one size on a coffee or tea page.
type Offer struct {
	Size      string
	Price     string
	PerUnit   string
	StoreWas  string
	RealDrop    int
	Usual       string
	LowestIn30  bool   // the window's lowest price and below the usual price
	LowestSince string // set when it is also the lowest since tracking began (30+ days)
	Available bool
	BuyURL    string
	Chart     string // inline SVG from sparkline, "" when there is no history yet
	Since     string // date of the first reading
}

// Coffee is a coffee or tea page; the labels are the words that differ.
type Coffee struct {
	Title      string
	Roaster    string
	RoasterURL string
	ImageURL   string
	BackURL    string
	Offers     []Offer
	Labels     Labels
}

// Labels are the words a coffee page and a tea page say differently.
type Labels struct {
	Back  string // "All coffees"
	Maker string // "Roasted by"
	Size  string // offers table: "Bag"
	Unit  string // offers table: "Per kg"
	Buy   string // "Go to roaster"
}

templ CoffeePage(p Page, c Coffee) {
	@Layout(p) {
		<nav class="crumbs"><a href={ templ.SafeURL(c.BackURL) }>{ c.Labels.Back }</a> / { c.Roaster }</nav>
		<article class="coffee">
			if c.ImageURL != "" {
				<img class="coffee-img" src={ c.ImageURL } alt={ c.Title } width="480" height="480"/>
			}
			<div>
				<h1>{ c.Title }</h1>
				<p class="muted">{ c.Labels.Maker } <a href={ templ.SafeURL(c.RoasterURL) } rel="nofollow">{ c.Roaster }</a></p>
				<table class="offers">
					<thead><tr><th>{ c.Labels.Size }</th><th>Price</th><th>{ c.Labels.Unit }</th><th>History</th><th>Verdict</th><th></th></tr></thead>
					<tbody>
						for _, o := range c.Offers {
							<tr>
								<td>{ o.Size }</td>
								<td class="price">{ o.Price }</td>
								<td class="muted">{ o.PerUnit }</td>
								<td class="history">
									if o.Chart != "" {
										@templ.Raw(o.Chart)
									}
									<span class="muted small">since { o.Since }</span>
								</td>
								<td>
									if o.LowestSince != "" {
										<span class="badge real">Lowest since { o.LowestSince }</span>
									} else if o.LowestIn30 {
										<span class="badge real">Lowest in 30 days</span>
									}
									if o.RealDrop > 0 {
										<span class="badge real">{ fmt.Sprintf("Real drop −%d%%", o.RealDrop) }</span>
										<span class="muted small">usual { o.Usual }</span>
									} else if o.Usual == "" {
										<span class="muted small">Not enough history yet</span>
									} else {
										<span class="muted small">At its usual price</span>
									}
									if o.StoreWas != "" {
										<span class="badge campaign">Store says was { o.StoreWas }</span>
									}
									if !o.Available {
										<span class="badge out">Out of stock</span>
									}
								</td>
								<td><a class="buy" href={ templ.SafeURL(o.BuyURL) } rel="nofollow">{ c.Labels.Buy }</a></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</article>
	}
}

templ NotFound(p Page, homeURL string) {
	@Layout(p) {
		<h1>Page not found</h1>
		<p class="lede">This page doesn't exist, or the store stopped selling it.</p>
		<p><a href={ templ.SafeURL(homeURL) }>Go to the home page</a></p>
	}
}
