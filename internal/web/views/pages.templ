package views

import "fmt"

// Card is one coffee or tea in a list: the sister sites' product row.
type Card struct {
	URL          string
	Title        string
	Roaster      string
	RoasterURL   string // the store's page here; "" when unknown
	ImageURL     string
	Size         string
	Price        string
	PerUnit      string // per kg for coffee, per 100 g for tea
	Usual        string // our usual price, "" until there is enough history
	Low30        string
	Lower        bool   // today's price is under the usual one, by any amount
	Saved        string // usual minus today, shown with a real drop
	RealDrop     int
	StoreWas     string
	StorePercent int // the store's own discount, from its "was" price
	LowestIn30   bool
	LowestSince  string
	OutOfStock   bool
	Chart        string // inline SVG, "" with fewer than two readings
	Reading      string // one sentence: what today's price means
	BuyURL       string
	Checked      string // when the store's prices were last read
	StoreNote    string // "The roaster's own shop"
	Market       string // "US": on the watchlist and the comparison
	Ref          string // "en-us/coffee/slug"
	Watched      bool
	Compared     bool
	WatchURL     string
	CompareURL   string
}

// Pager links the pages of a list with plain, crawlable links.
type Pager struct {
	Page, Pages int
	Total       int
	PrevURL     string
	NextURL     string
	Items       []PageItem
}

// PageItem is a page number of the pager, or a gap between numbers.
type PageItem struct {
	N       int
	URL     string
	Current bool
	Gap     bool
}

// Option is one choice of a select.
type Option struct {
	Value    string
	Label    string
	Selected bool
}

// Deals is a list with the sister sites' controls: the view switch, the
// store, category and order selects, the active filters and the pages.
type Deals struct {
	Action     string // the list's address: the controls submit here
	Show       string
	Query      string
	Views      []NavLink
	ViewNote   string
	Roasters   []Option // empty on a store's own page
	Categories []Option
	Sorts      []Option
	Chips      []NavLink // active filters, each with the link that removes it
	ClearURL   string
	Cards      []Card
	Total      int64
	Pager      Pager
	Labels     Labels
	Elsewhere  *NavLink // a search with nothing here, in the other section
	MoreURL    string   // the home page: one link to the full list instead of pages
	MoreLabel  string
}

// Hero is the band's text and today's top deal.
type Hero struct {
	Crumbs    []NavLink
	Heading   string
	Lede      string
	Tracked   string
	Count     int64
	LastCheck string
	Currency  string
	Top       *Card
	TopChart  string
	Labels    Labels
}

// Listing is a list page: the home page and every market's sections.
type Listing struct {
	Hero  Hero
	Deals Deals
}

// Offer is one size on a coffee or tea page.
type Offer struct {
	Size        string
	Price       string
	Amount      string // the price as a plain number, for the cost calculator
	Grams       int32
	PerUnit     string
	StoreWas    string
	RealDrop    int
	Usual       string
	LowestIn30  bool   // the window's lowest price and below the usual price
	LowestSince string // set when it is also the lowest since tracking began (30+ days)
	Available   bool
	BuyURL      string
	Chart       string // inline SVG from sparkline, "" when there is no history yet
	Big         string // the history card's chart, same rule
	Since       string // date of the first reading
	High, Low   string // the highest and lowest price in the chart's window
	Anchor      string
	Reading     string
	Today       string
	Low30       string
	Against     string // today against the usual price, signed
	AgainstNote string
	Lower       bool
	RateNote    string // why a lower converted price is no drop; "" otherwise
}

// Coffee is a coffee or tea page; the labels are the words that differ.
type Coffee struct {
	Title      string
	Roaster    string
	RoasterURL string
	ImageURL   string
	BackURL    string
	Section    string // "US coffee"
	Checked    string
	Offers     []Offer
	Featured   int // index of the size the page opens on
	Labels     Labels
	Kind       string
	Ref        string
	Watched    bool
	Compared   bool
	WatchURL   string
	CompareURL string
}

// Labels are the words a coffee page and a tea page say differently.
type Labels struct {
	Back      string // "All coffees"
	Maker     string // "Roasted by"
	Size      string // "Bag"
	Unit      string // "Per kg"
	Buy       string // "Go to roaster"
	StoreNote string // "The roaster's own shop"
}

// verdictClass colors the verdict box like the badge it explains.
func verdictClass(o Offer) string {
	switch {
	case !o.Available:
		return "verdict"
	case o.RealDrop > 0:
		return "verdict verdict-green"
	case o.StoreWas != "":
		return "verdict verdict-amber"
	}
	return "verdict"
}

// orDash is a figure or "—" when there is none (never a guess).
func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// dealBadge is a row's one badge, as on the sister sites: a real drop in
// green, else the store's own sale in amber; out of stock beside it.
templ dealBadge(c Card) {
	if c.LowestSince != "" {
		<span class="badge badge-green">{ tr(ctx, "deal.lowest_since", "date", c.LowestSince) }</span>
	} else if c.LowestIn30 {
		<span class="badge badge-green">{ tr(ctx, "deal.lowest_30") }</span>
	} else if c.RealDrop > 0 {
		<span class="badge badge-green">{ tr(ctx, "deal.real_drop", "pct", fmt.Sprint(c.RealDrop)) }</span>
	} else if c.StorePercent > 0 {
		<span class="badge badge-amber">{ tr(ctx, "deal.store_sale_pct", "pct", fmt.Sprint(c.StorePercent)) }</span>
	}
	if c.OutOfStock {
		<span class="badge">{ tr(ctx, "deal.out_of_stock") }</span>
	}
}

// productRow is the sister sites' product row: image, name, price, chart,
// store.
templ productRow(c Card, labels Labels) {
	<article class="deal-row">
		<a class="deal-img" href={ templ.SafeURL(c.URL) } tabindex="-1" aria-hidden="true">
			if c.ImageURL != "" {
				<img src={ c.ImageURL } alt="" width="240" height="240" loading="lazy" decoding="async"/>
			}
			<span class="img-brand">{ c.Roaster }</span>
		</a>
		<div class="deal-details">
			<div class="badges">
				@dealBadge(c)
			</div>
			<a class="deal-title" href={ templ.SafeURL(c.URL) }>
				<h3 title={ c.Title }>{ c.Title }</h3>
				<p>
					{ c.Roaster }
					if c.Size != "" {
						{ " · " + c.Size }
					}
					if c.Market != "" {
						{ " · " + c.Market }
					}
				</p>
			</a>
			<div class="deal-meta">
				<span class="tracked">
					@icon("seal")
					{ tr(ctx, "card.history_tracked") }
				</span>
				if c.Checked != "" {
					<span>{ c.Checked }</span>
				}
				if c.CompareURL != "" {
					<a href={ templ.SafeURL(c.CompareURL) } rel="nofollow">
						if c.Compared {
							@icon("check")
							{ tr(ctx, "card.added_compare") }
						} else {
							@icon("scales")
							{ tr(ctx, "card.compare") }
						}
					</a>
				}
			</div>
		</div>
		<div class="deal-price">
			<div class="amount">{ c.Price }</div>
			if c.Saved != "" {
				<div class="was"><s>{ c.Usual }</s></div>
				<div class="save-row"><span class="save-pill">{ fmt.Sprintf("%d%%", c.RealDrop) }</span><span>{ tr(ctx, "deal.you_save", "amount", c.Saved) }</span></div>
			} else if c.StorePercent > 0 {
				<div class="was"><s>{ c.StoreWas }</s></div>
				<div class="save-row"><span class="badge badge-amber">{ tr(ctx, "deal.store_off", "pct", fmt.Sprint(c.StorePercent)) }</span></div>
			}
			if c.PerUnit != "" {
				<div class="unit">{ c.PerUnit }</div>
			}
		</div>
		<div class="deal-chart">
			if c.Chart != "" {
				@templ.Raw(c.Chart)
			} else {
				<span class="nochart">{ tr(ctx, "card.history_starts") }</span>
			}
			<a class="history-link" href={ templ.SafeURL(c.URL) }>
				{ tr(ctx, "card.see_history") }
				@icon("arrow-right")
			</a>
		</div>
		<div class="deal-store">
			<div class="store-name">{ c.Roaster }</div>
			<div class="store-type">{ c.StoreNote }</div>
			<a class="btn btn-primary" href={ templ.SafeURL(c.BuyURL) } rel="nofollow">
				{ labels.Buy }
				@icon("external")
			</a>
			if c.CompareURL != "" {
				<a class="btn btn-ghost btn-small" href={ templ.SafeURL(c.CompareURL) } rel="nofollow">
					if c.Compared {
						@icon("check")
						{ tr(ctx, "card.added") }
					} else {
						@icon("scales")
						{ tr(ctx, "card.compare") }
					}
				</a>
			}
		</div>
	</article>
}

// dealList is a list of rows in one card.
templ dealList(cards []Card, labels Labels, label string) {
	<section class="deal-list" aria-label={ label }>
		for _, c := range cards {
			@productRow(c, labels)
		}
	</section>
}

// heroBand is the band's left column and today's top deal.
templ heroBand(h Hero) {
	<section class="wrap hero-grid">
		<div class="hero-text">
			if len(h.Crumbs) > 0 {
				@crumbs(h.Crumbs)
			}
			<h1>{ h.Heading }</h1>
			if h.Lede != "" {
				<p class="lede">{ h.Lede }</p>
			}
			<div class="hero-stats">
				if h.Tracked != "" {
					<span>
						@icon("shield")
						{ h.Tracked }
					</span>
				}
				if h.LastCheck != "" {
					<span><i class="live-dot" aria-hidden="true"></i>{ tr(ctx, "hero.last_check", "time", h.LastCheck) }</span>
				}
				if h.Currency != "" {
					<span>{ h.Currency }</span>
				}
			</div>
		</div>
		if h.Top != nil {
			@featuredDeal(*h.Top, h.TopChart, h.Labels)
		}
	</section>
}

templ crumbs(links []NavLink) {
	<nav class="crumbs" aria-label={ tr(ctx, "nav.breadcrumb") }>
		for i, l := range links {
			if i > 0 {
				<span aria-hidden="true">/</span>
			}
			if i == len(links)-1 {
				<span>{ l.Name }</span>
			} else {
				<a href={ templ.SafeURL(l.URL) }>{ l.Name }</a>
			}
		}
	</nav>
}

// featuredDeal is the band's "Today's top deal" card.
templ featuredDeal(c Card, chart string, labels Labels) {
	<article class="featured">
		<a class="featured-img" href={ templ.SafeURL(c.URL) } tabindex="-1" aria-hidden="true">
			if c.ImageURL != "" {
				<img src={ c.ImageURL } alt="" width="240" height="240" decoding="async"/>
			}
		</a>
		<a class="featured-info" href={ templ.SafeURL(c.URL) }>
			<span class="kicker">{ tr(ctx, "top.kicker") }</span>
			<h2>{ c.Title }</h2>
			<p class="featured-meta">{ c.Roaster } · { c.Size }</p>
			<p class="checked">
				@icon("seal")
				{ tr(ctx, "top.checked") }
			</p>
		</a>
		<div class="featured-price">
			if c.LowestSince != "" {
				<span class="badge badge-green">{ tr(ctx, "deal.lowest_since", "date", c.LowestSince) }</span>
			} else if c.LowestIn30 {
				<span class="badge badge-green">{ tr(ctx, "deal.lowest_30") }</span>
			}
			<div class="featured-amount">{ c.Price }</div>
			if c.Saved != "" {
				<div class="save-row"><span class="save-pill">{ fmt.Sprintf("%d%%", c.RealDrop) }</span><span>{ tr(ctx, "deal.you_save", "amount", c.Saved) }</span></div>
			} else if c.StorePercent > 0 {
				<div class="save-row"><span class="badge badge-amber">{ tr(ctx, "deal.store_sale_top", "pct", fmt.Sprint(c.StorePercent)) }</span></div>
			}
		</div>
		<div class="featured-chart">
			if chart != "" {
				@templ.Raw(chart)
			} else {
				<p>{ tr(ctx, "top.building") }</p>
			}
		</div>
		<div class="featured-actions">
			<a class="btn btn-primary" href={ templ.SafeURL(c.BuyURL) } rel="nofollow">
				{ labels.Buy }
				@icon("external")
			</a>
			<a class="btn btn-outline" href={ templ.SafeURL(c.URL) }>{ tr(ctx, "top.view_history") }</a>
		</div>
	</article>
}

// dealsSection is a list with the sister sites' controls. The controls are a
// GET form (the "Filter" button applies the selects) and links.
templ dealsSection(d Deals) {
	<section class="deals" id="products">
		<form class="deal-controls" method="get" action={ templ.SafeURL(d.Action) }>
			<div class="view-wrap">
				<nav class="view-switch" aria-label={ tr(ctx, "list.view") }>
					for _, v := range d.Views {
						if v.Current {
							<a href={ templ.SafeURL(v.URL) } aria-current="page">{ v.Name }</a>
						} else {
							<a href={ templ.SafeURL(v.URL) }>{ v.Name }</a>
						}
					}
				</nav>
				<p class="view-note">{ d.ViewNote }</p>
			</div>
			<div class="filter-row">
				if d.Show != "" {
					<input type="hidden" name="show" value={ d.Show }/>
				}
				if d.Query != "" {
					<input type="hidden" name="q" value={ d.Query }/>
				}
				<button class="btn btn-ghost" type="submit">
					@icon("funnel")
					{ tr(ctx, "list.filter") }
				</button>
				if d.ClearURL != "" {
					<a class="btn btn-ghost" href={ templ.SafeURL(d.ClearURL) }>{ tr(ctx, "list.clear_filters") }</a>
				}
				if len(d.Roasters) > 0 {
					@selectBox("roaster", tr(ctx, "list.by_store"), d.Roasters)
				}
				@selectBox("cat", tr(ctx, "list.by_category"), d.Categories)
				@selectBox("sort", tr(ctx, "list.sort"), d.Sorts)
			</div>
		</form>
		if len(d.Chips) > 0 {
			<div class="chips-row">
				for _, c := range d.Chips {
					<a class="filter-chip" href={ templ.SafeURL(c.URL) }>
						{ c.Name }
						@icon("x")
						<span class="sr-only">{ tr(ctx, "list.remove") }</span>
					</a>
				}
			</div>
		}
		if len(d.Cards) == 0 {
			<div class="card empty">
				@icon("search")
				<h2>{ tr(ctx, "list.empty") }</h2>
				<p>{ tr(ctx, "list.empty_hint") }</p>
				if d.Elsewhere != nil {
					<p><a class="link" href={ templ.SafeURL(d.Elsewhere.URL) }>{ d.Elsewhere.Name }</a></p>
				}
				if d.ClearURL != "" {
					<a class="btn btn-primary" href={ templ.SafeURL(d.ClearURL) }>{ tr(ctx, "list.clear_filters") }</a>
				}
			</div>
		} else {
			@dealList(d.Cards, d.Labels, tr(ctx, "list.products"))
			if d.MoreURL != "" {
				<p class="more-row">
					<a class="btn btn-primary" href={ templ.SafeURL(d.MoreURL) }>
						{ d.MoreLabel }
						@icon("arrow-right")
					</a>
				</p>
			} else if d.Pager.Pages > 1 {
				@pagerNav(d.Pager)
			}
		}
	</section>
}

templ selectBox(name, label string, options []Option) {
	<select class="filter-control" name={ name } aria-label={ label }>
		for _, o := range options {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
		}
	</select>
}

// pagerNav is the sister sites' numbered page row.
templ pagerNav(p Pager) {
	<nav class="pager" aria-label={ tr(ctx, "pager.label") }>
		if p.PrevURL != "" {
			<a class="pager-btn" href={ templ.SafeURL(p.PrevURL) } rel="prev" aria-label={ tr(ctx, "pager.prev") }>
				@icon("caret-left")
			</a>
		} else {
			<span class="pager-btn off" aria-hidden="true">
				@icon("caret-left")
			</span>
		}
		for _, it := range p.Items {
			if it.Gap {
				<span class="pager-gap" aria-hidden="true">…</span>
			} else if it.Current {
				<span class="pager-btn current" aria-current="page">{ fmt.Sprint(it.N) }</span>
			} else {
				<a class="pager-btn" href={ templ.SafeURL(it.URL) } aria-label={ tr(ctx, "pager.page", "n", fmt.Sprint(it.N)) }>{ fmt.Sprint(it.N) }</a>
			}
		}
		if p.NextURL != "" {
			<a class="pager-btn" href={ templ.SafeURL(p.NextURL) } rel="next" aria-label={ tr(ctx, "pager.next") }>
				@icon("caret-right")
			</a>
		} else {
			<span class="pager-btn off" aria-hidden="true">
				@icon("caret-right")
			</span>
		}
	</nav>
	<p class="pager-note">{ tr(ctx, "pager.note", "page", fmt.Sprint(p.Page), "pages", fmt.Sprint(p.Pages), "total", fmt.Sprint(p.Total)) }</p>
}

// Home is the sister sites' home page: the band, the strip, the US list,
// the guides and the questions.
templ Home(p Page, l Listing) {
	@Layout(p, heroBand(l.Hero)) {
		@dealsSection(l.Deals)
		@guidesTeaser()
		@faq()
	}
}

// MarketHome is a market's list of one section, or of one category.
templ MarketHome(p Page, l Listing) {
	@Layout(p, heroBand(l.Hero)) {
		@dealsSection(l.Deals)
	}
}

// faq is the home page's questions, from the rules the site runs on.
templ faq() {
	<section class="faq" id="faq">
		<div class="section-center">
			<span class="kicker">{ tr(ctx, "common.transparency") }</span>
			<h2>{ tr(ctx, "faq.title") }</h2>
		</div>
		<div class="faq-list">
			<details class="card faq-item">
				<summary>
					{ tr(ctx, "faq.q1") }
					@icon("caret-down")
				</summary>
				<p>{ tr(ctx, "faq.a1") }</p>
			</details>
			<details class="card faq-item">
				<summary>
					{ tr(ctx, "faq.q2") }
					@icon("caret-down")
				</summary>
				<p>{ tr(ctx, "faq.a2") }</p>
			</details>
			<details class="card faq-item">
				<summary>
					{ tr(ctx, "faq.q3") }
					@icon("caret-down")
				</summary>
				<p>{ tr(ctx, "faq.a3") }</p>
			</details>
			<details class="card faq-item">
				<summary>
					{ tr(ctx, "faq.q4") }
					@icon("caret-down")
				</summary>
				<p>{ tr(ctx, "faq.a4") }</p>
			</details>
			<details class="card faq-item">
				<summary>
					{ tr(ctx, "faq.q5") }
					@icon("caret-down")
				</summary>
				<p>{ tr(ctx, "faq.a5") }</p>
			</details>
		</div>
	</section>
}

templ productHero(c Coffee) {
	<section class="wrap band-crumbs">
		@crumbs([]NavLink{{Name: tr(ctx, "nav.home"), URL: "/"}, {Name: c.Section, URL: c.BackURL}, {Name: c.Roaster}})
	</section>
}

func lower(s string) string {
	b := []byte(s)
	for i, c := range b {
		if c >= 'A' && c <= 'Z' {
			b[i] = c + 32
		}
	}
	return string(b)
}

// CoffeePage is the sister sites' product sheet: the price analysis of each
// size, the size the visitor came for first.
templ CoffeePage(p Page, c Coffee) {
	@Layout(p, productHero(c)) {
		if len(c.Offers) > 0 {
			<article class="sheet">
				<header class="sheet-head">
					<span class="sheet-img">
						if c.ImageURL != "" {
							<img src={ c.ImageURL } alt={ c.Title } width="240" height="240"/>
						}
					</span>
					<div class="sheet-title">
						<p class="kicker">{ c.Roaster }</p>
						<h1>{ c.Title }</h1>
						<p class="sheet-checked">{ tr(ctx, "product.price_checked", "date", c.Checked, "section", c.Section) }</p>
					</div>
					<div class="sheet-tools">
						<a class="icon-btn" href={ templ.SafeURL(c.WatchURL) } rel="nofollow" title={ tr(ctx, "nav.watchlist") }>
							if c.Watched {
								@icon("bookmark-fill")
								<span class="sr-only">{ tr(ctx, "product.remove_watch") }</span>
							} else {
								@icon("bookmark")
								<span class="sr-only">{ tr(ctx, "product.add_watch") }</span>
							}
						</a>
					</div>
				</header>
				@sizePick(c, c.Featured)
				@sizeSheet(c, c.Featured)
				for i := range c.Offers {
					if i != c.Featured {
						@sizePick(c, i)
						@sizeSheet(c, i)
					}
				}
				<div class="sheet-actions">
					<a class="btn btn-ghost" href={ templ.SafeURL(c.WatchURL) } rel="nofollow">
						if c.Watched {
							@icon("bookmark-fill")
							{ tr(ctx, "product.on_watch") }
						} else {
							@icon("bookmark")
							{ tr(ctx, "product.add_watch") }
						}
					</a>
					<a class="btn btn-ghost" href={ templ.SafeURL(c.CompareURL) } rel="nofollow">
						if c.Compared {
							@icon("check")
							{ tr(ctx, "card.added_compare") }
						} else {
							@icon("scales")
							{ tr(ctx, "card.compare") }
						}
					</a>
					if c.Kind == "coffee" {
						{{ f := c.Offers[c.Featured] }}
						if f.Grams > 0 {
							<a class="btn btn-ghost" href={ templ.SafeURL(fmt.Sprintf("/calculators/cost-per-cup?price=%s&grams=%d", f.Amount, f.Grams)) }>
								@icon("calculator")
								{ tr(ctx, "product.cost_per_cup") }
							</a>
						}
					}
				</div>
			</article>
		}
	}
}

// sizePick is the radio that shows size i's sheet, right before that sheet.
// The size chips switch sizes in place, without a script: they are labels of
// these radios, and one rule (.size-pick:not(:checked) + .sheet-size) hides
// the other sheets, for any number of sizes. The chips used to be links to
// #size-N anchors, so picking a size jumped down the page to its sheet (6 Nov,
// reported). The radios are position: fixed in the CSS: clicking a label
// focuses its radio, and a radio sitting below the visible sheet would scroll
// the page down to it all the same. A single size gets no radio and no chips.
templ sizePick(c Coffee, i int) {
	if len(c.Offers) > 1 {
		<input
			class="size-pick"
			type="radio"
			name="size"
			id={ "pick-" + c.Offers[i].Anchor }
			aria-label={ c.Offers[i].Size }
			if i == c.Featured {
				checked
			}
		/>
	}
}

// sizeSheet is one size's price analysis. Each sheet carries the size chips
// with its own size marked: only the picked sheet shows, so the marked chip is
// always the picked one. The chips are hidden from screen readers; the radios,
// named by aria-label, are the control there.
templ sizeSheet(c Coffee, i int) {
	{{ s := c.Offers[i] }}
	<section class="sheet-size" id={ s.Anchor }>
		if len(c.Offers) > 1 {
			<div class="size-tabs" aria-hidden="true">
				for j, o := range c.Offers {
					<label
						for={ "pick-" + o.Anchor }
						if j == i {
							class="current"
						}
					>{ o.Size }</label>
				}
			</div>
		}
		<div class="sheet-row">
			<div>
				<p class="kicker">{ tr(ctx, "product.real_history") }</p>
				<h2>{ tr(ctx, "product.analysis") } <span>{ sizeNoun(ctx, s.Size, c.Labels.Size) }</span></h2>
			</div>
			<div class="sheet-price">
				<b>{ s.Price }</b>
				<span>{ tr(ctx, "product.current") }</span>
			</div>
		</div>
		if s.Big != "" {
			<div class="sheet-chart">
				@templ.Raw(s.Big)
			</div>
		} else {
			<p class="nochart">{ tr(ctx, "product.no_chart") }</p>
		}
		<div class="sheet-stats">
			<div><span>{ tr(ctx, "product.period_low") }</span><b>{ orDash(s.Low) }</b></div>
			<div class="current"><span>{ tr(ctx, "product.current") }</span><b>{ s.Price }</b></div>
			<div><span>{ tr(ctx, "product.period_high") }</span><b>{ orDash(s.High) }</b></div>
		</div>
		<div class={ verdictClass(s) }>
			<p class="verdict-title">{ verdictTitle(ctx, s) }</p>
			<p>{ s.Reading }</p>
		</div>
		<h3>{ tr(ctx, "product.measured") }</h3>
		<dl class="measured">
			<div>
				<dt>{ tr(ctx, "product.usual") }</dt>
				if s.Usual != "" {
					<dd>{ s.Usual } <span>{ tr(ctx, "product.usual_rule") }</span></dd>
				} else {
					<dd>{ tr(ctx, "product.not_enough") }</dd>
				}
			</div>
			<div><dt>{ tr(ctx, "product.since") }</dt><dd>{ orDash(s.Since) }</dd></div>
			<div><dt>{ tr(ctx, "product.low30") }</dt><dd>{ orDash(s.Low30) }</dd></div>
			if s.Against != "" {
				<div><dt>{ tr(ctx, "product.against") }</dt><dd>{ s.Against } <span>{ s.AgainstNote }</span></dd></div>
			}
			<div>
				<dt>{ tr(ctx, "product.store_shows") }</dt>
				if s.StoreWas != "" {
					<dd>{ tr(ctx, "product.was", "price", s.StoreWas) } <span>{ tr(ctx, "product.store_claim") }</span></dd>
				} else {
					<dd>{ tr(ctx, "product.no_sale") }</dd>
				}
			</div>
			if s.PerUnit != "" {
				<div><dt>{ c.Labels.Unit }</dt><dd>{ s.PerUnit }</dd></div>
			}
			<div>
				<dt>{ tr(ctx, "product.stock") }</dt>
				if s.Available {
					<dd>{ tr(ctx, "product.in_stock") }</dd>
				} else {
					<dd>{ tr(ctx, "product.out_of_stock") }</dd>
				}
			</div>
		</dl>
		<a class="btn btn-primary btn-block" href={ templ.SafeURL(s.BuyURL) } rel="nofollow">
			{ c.Labels.Buy }
			@icon("external")
		</a>
		<p class="sheet-note">{ tr(ctx, "product.sheet_note", "date", c.Checked, "store_note", c.Labels.StoreNote) }</p>
	</section>
}

templ notFoundHero() {
	<section class="wrap hero-grid">
		<div class="hero-text">
			<h1>{ tr(ctx, "notfound.title") }</h1>
			<p class="lede">{ tr(ctx, "notfound.lede") }</p>
		</div>
	</section>
}

templ NotFound(p Page, homeURL string) {
	@Layout(p, notFoundHero()) {
		<div class="card empty">
			@icon("warning")
			<h2>{ tr(ctx, "notfound.nothing") }</h2>
			<p>{ tr(ctx, "notfound.hint") }</p>
			<a class="btn btn-primary" href={ templ.SafeURL(homeURL) }>{ tr(ctx, "notfound.home") }</a>
		</div>
	}
}
