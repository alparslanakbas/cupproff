# CoffeeProof's hosts (the site was named CupProof until 4 Nov 2026; the file,
# the container and the log keep that name), for the Turkish stack's Caddy on the same VM, the way
# WheyProof's are: that Caddyfile imports site files from a mounted
# directory, and its global options (Cloudflare's trusted_proxies) apply
# here too.
#
# NOT MOUNTED YET. coffeeproof.org was bought on 4 Nov 2026 (Cloudflare
# Registrar); until its DNS points here, Caddy would only fail to get
# certificates for these names. On the day: mount this directory in the
# Turkish compose file, add the import, run `caddy validate`, deploy.
#
# The upstream is the network alias the site container gets on "web-edge"
# (scripts/deploy.sh). A broken file here takes every site of that Caddy
# down on its next restart: validate before deploying.

(cupproof-access-log) {
	log {
		# Its own file; no tokens in our URLs (no accounts), so nothing to mask.
		output file /var/log/caddy/cupproof-access.log {
			roll_size 20MiB
			roll_keep 50
			roll_keep_for 2160h
		}
		format json
	}
}

www.coffeeproof.org {
	import cupproof-access-log
	encode zstd gzip
	reverse_proxy cupproof-web:8080
}

# One canonical host, as on the sister sites.
coffeeproof.org {
	import cupproof-access-log
	redir https://www.coffeeproof.org{uri} permanent
}
